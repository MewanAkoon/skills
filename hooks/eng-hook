#!/bin/sh
# Hook entry point for the eng plugin. hooks/hooks.json runs it as
#
#   eng-hook <mode>
#
# with the hook's JSON input on stdin, one mode per event:
#
#   session-start  SessionStart. Sends the workflow contract and the
#                  Punctuation and Word choice sections of plain-writing, read
#                  from the plugin's own files at run time. On a compaction it
#                  also asks Claude Code to load the skill listing again, which
#                  compaction drops.
#   prompt         UserPromptSubmit. Keeps your latest message for the write
#                  gate, and adds a hint when it is a pull request link.
#   expansion      UserPromptExpansion. Records a skill you type, blocks
#                  /code-review with --comment or --post, and records the
#                  tree a review you type will read.
#   pre-tool       PreToolUse. The post guard, the write gate and the
#                  confirmation prompt for shell commands and MCP tools, and
#                  the guard on a code-review the model calls. Before a push or
#                  a pull request command, keeps where the remote branches
#                  stood.
#   post-tool      PostToolUse and PostToolUseFailure. Records a skill that
#                  loaded and a push that moved a remote branch to HEAD, and
#                  adds a hint when git reports a conflict.
#   stop           Stop. The review gate, and the reminder to review the
#                  whole pull request after a push.
#
# State lives in ${CLAUDE_PLUGIN_DATA}/sessions/<session>/, which survives
# plugin updates: turn (the text of your latest message), skills (those loaded
# since), start-hash (the uncommitted changes when the session started) and
# review-hash (the same when a review covering them last ran), push-pending
# (a push or pull request command about to run, with where every remote
# branch stood before it), reviewed-commit (the end of the last range reviewed),
# pr-head (the commit the last push or new pull request left on a remote
# branch), pr-review (that commit, once a review reached it) and pr-reminded
# (that commit, once the stop gate asked for its review). It is not read from
# the transcript, which Claude Code writes asynchronously. Where the state
# cannot be read, the write gate allows, as every other check fails open.
#
# Every failure exits 0, so a broken hook never stops a session or a tool. A
# failure is written to eng-hook.log in ${CLAUDE_PLUGIN_DATA}, which
# check.sh --doctor reads. Needs jq. Without it the session block goes out as
# plain text, which Claude Code also takes as context, and every other mode
# does nothing.

set -u

mode="${1:-}"
root="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
input=""
state=""

# The code-review flags that post to a pull request.
POST_FLAGS='--comment(=[^[:space:]]*)?|--post(=[^[:space:]]*)?'

POST_REASON="Posting a comment, review or reply is off limits in this setup, and \
no approval releases it. Write the draft to a file with the command that would \
post it, give the user the path, and say that is why. Reading stays open."

# The words in a message that name a write. A refusal such as "don't stage,
# commit or push" may list several before the one it refuses.
WRITE_WORDS='commit(s|ted|ting)?|push(ed|es|ing)?|stag(e|ed|ing)|check(ed)?( it)? ?in|prs?|pull[ -]requests?|merge[ -]requests?|mrs?|issues?|tickets?'

# The words in an MCP tool's name that say what it does: it reads, it posts,
# or it writes somewhere else.
READS="read get list search fetch view retrieve query find lookup download"
POSTS="comment comments reply review reviews reaction reactions approve"
WRITES="create update delete apply execute deploy merge upload set send post \
publish share trash remove append insert clear move edit write submit add \
assign close reopen archive unarchive push commit fork schedule save request \
forward run invoke trigger dispatch duplicate restore generate batch upsert \
patch rename drop cancel reset transition invite enable disable rerun copy \
import revoke grant destroy terminate stop kill rollback restart scale reboot \
shutdown convert modify reprioritize star unstar dismiss mark manage subscribe \
unsubscribe follow unfollow"

REVIEW_REMINDER="There are uncommitted changes that have not been reviewed since \
they last changed. If this hands back finished work, run the review step in \
eng:implement first. If you are stopping to ask a question or report a blocker, \
say so and end the turn."

PR_REMINDER="This branch was pushed, or its PR opened, since the PR was last \
reviewed as a whole. Before handing back, check whether the branch has an open \
PR. If it has none, say nothing of this and end the turn. If it has one, \
review the whole PR as step 6 of the workflow says: /code-review high on the \
range from the merge base with the PR's base branch to HEAD, then judge the \
findings and fix the valid ones. If you are stopping to ask a question or \
report a blocker, say so and end the turn."

log() {
  printf 'eng-hook: %s\n' "$1" >&2
  [ -n "${CLAUDE_PLUGIN_DATA:-}" ] || return 0
  mkdir -p "$CLAUDE_PLUGIN_DATA" 2>/dev/null || return 0
  printf '%s %s error: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$mode" "$1" \
    >> "$CLAUDE_PLUGIN_DATA/eng-hook.log" 2>/dev/null
  return 0
}

# Prints one value from the hook's input, or nothing when it is absent.
get() {
  printf '%s' "$input" | jq -r "$1 // empty" 2>/dev/null
}

# Prints the JSON that adds $2 as context on the event named $1.
context() {
  jq -n --arg e "$1" --arg c "$2" \
    '{hookSpecificOutput: {hookEventName: $e, additionalContext: $c}}'
}

# Prints the JSON for a PreToolUse decision, $1, with the reason $2.
decision() {
  jq -n --arg d "$1" --arg r "$2" '{hookSpecificOutput: {
    hookEventName: "PreToolUse", permissionDecision: $d, permissionDecisionReason: $r
  }}'
}

# Prints this session's state directory without creating it. Fails when there
# is no data directory or no session id.
state_path() {
  [ -n "${CLAUDE_PLUGIN_DATA:-}" ] || return 1
  sid="$(printf '%s' "$f_sid" | tr -c 'A-Za-z0-9_-' '-')"
  [ -n "$sid" ] || return 1
  printf '%s\n' "$CLAUDE_PLUGIN_DATA/sessions/$sid"
}

# Sets $state to this session's state directory, creating it. Fails when
# there is no data directory or no session id.
find_state() {
  [ -z "$state" ] || return 0
  state="$(state_path)" || { state=""; return 1; }
  if ! mkdir -p "$state" 2>/dev/null; then
    log "cannot create $state"
    state=""
    return 1
  fi
  # Session start prunes directories by age, so a session in use stays young.
  touch "$state" 2>/dev/null
  return 0
}

# A skill's name as the gate compares it: eng:commit, /eng:commit and commit
# are all commit.
skill_name() {
  n="${1#/}"
  printf '%s' "${n#eng:}"
}

record_skill() {
  [ -n "$1" ] || return 0
  find_state || return 0
  skill_name "$1" >> "$state/skills"
  printf '\n' >> "$state/skills"
}

# True when the words in $1 hold one matching the extended regex $2.
has_word() {
  printf ' %s ' "$1" | tr '\t\n' '  ' | grep -Eiq "[[:space:]]($2)[[:space:]]"
}

# Prints a hash of the uncommitted changes in the repo holding directory $1,
# tracked and untracked, leaving out .claude/plans and .claude/handoffs. Prints "clean" when there
# are none, and fails outside a git repo.
tree_state() {
  top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [ -n "$top" ] || return 1
  base=HEAD
  # A repo with no commit yet compares against the empty tree.
  git -C "$top" rev-parse -q --verify HEAD >/dev/null 2>&1 ||
    base=4b825dc642cb6eb9a060e54bf8d69288fbee4904
  # Plans and handoffs are left out, as the review loop's snapshot leaves them.
  # The untracked names are listed once, NUL-separated, so a quote or a
  # newline in one cannot break the list.
  ts_list="$(mktemp "${TMPDIR:-/tmp}/eng-hook-untracked.XXXXXX")" || return 1
  git -C "$top" ls-files -z --others --exclude-standard -- . \
    ':(exclude).claude/plans' ':(exclude).claude/handoffs' > "$ts_list" 2>/dev/null
  if git -C "$top" diff --quiet "$base" -- . ':(exclude).claude/plans' ':(exclude).claude/handoffs' 2>/dev/null &&
    [ ! -s "$ts_list" ]; then
    rm -f "$ts_list"
    printf 'clean\n'
    return 0
  fi
  # The diff streams into the hash rather than sitting in a variable. The
  # untracked files are hashed a hundred at a time; a batch that fails is
  # dropped and hashed file by file, so one that cannot be, such as a link to
  # a directory, stands as its name and only its batch is slowed. The script is single-quoted
  # for sh -c, which expands its arguments.
  # shellcheck disable=SC2016
  ts_hash="$(
    {
      git -C "$top" diff --binary "$base" -- . ':(exclude).claude/plans' ':(exclude).claude/handoffs' 2>/dev/null
      tr '\0' '\n' < "$ts_list"
      [ -s "$ts_list" ] && (cd "$top" && xargs -0 -n 100 sh -c '
        out="$(git hash-object -- "$@" 2>/dev/null)" && { printf "%s\n" "$out"; exit 0; }
        for f; do git hash-object -- "$f" 2>/dev/null || printf "unhashed %s\n" "$f"; done
      ' sh < "$ts_list")
    } | git -C "$top" hash-object --stdin
  )"
  rm -f "$ts_list"
  [ -n "$ts_hash" ] || return 1
  printf '%s\n' "$ts_hash"
}

# Prints the tree object of the working tree as the review loop snapshots it:
# every file, untracked too, with the plans and handoffs as HEAD has them.
worktree_tree() {
  wt_index="$(mktemp "${TMPDIR:-/tmp}/eng-hook-index.XXXXXX")" || return 1
  # Built from HEAD rather than a copy of the index, whose cached file stats
  # can hide an edit made in the same second as the copy.
  rm -f "$wt_index"
  # A step that fails leaves a partial index, whose tree is not this one.
  if GIT_INDEX_FILE="$wt_index" git -C "$1" read-tree HEAD 2>/dev/null &&
    GIT_INDEX_FILE="$wt_index" git -C "$1" add -A 2>/dev/null &&
    GIT_INDEX_FILE="$wt_index" git -C "$1" reset -q -- ':/.claude/plans' ':/.claude/handoffs' 2>/dev/null; then
    GIT_INDEX_FILE="$wt_index" git -C "$1" write-tree 2>/dev/null
    wt_status=$?
  else
    wt_status=1
  fi
  rm -f "$wt_index"
  return "$wt_status"
}

# Prints each remote's default branch in the repo at $1, one ref per line.
# Where a remote names no default, its main and master stand in.
default_refs() {
  for remote in $(git -C "$1" remote 2>/dev/null); do
    default="$(git -C "$1" symbolic-ref -q "refs/remotes/$remote/HEAD" 2>/dev/null)"
    if [ -n "$default" ]; then
      printf '%s\n' "$default"
    else
      printf '%s\n' "refs/remotes/$remote/main" "refs/remotes/$remote/master"
    fi
  done
}

# Succeeds when the range $2..$3 in the repo at $1 starts at or before where
# $3 left some remote's default branch, so it reads the whole pull request
# rather than its last few commits.
whole_range() {
  range_first="$(git -C "$1" rev-parse -q --verify "$2^{commit}" 2>/dev/null)" || return 1
  for default in $(default_refs "$1"); do
    range_base="$(git -C "$1" merge-base "$default" "$3" 2>/dev/null)" || continue
    git -C "$1" merge-base --is-ancestor "$range_first" "$range_base" 2>/dev/null && return 0
  done
  return 1
}

# Records that the commit $1 was reviewed as the pull request, when it is the
# one the last push or new pull request left on a remote branch.
mark_pr_reviewed() {
  [ -n "$1" ] || return 0
  [ "$1" = "$(cat "$state/pr-head" 2>/dev/null)" ] || return 0
  printf '%s\n' "$1" > "$state/pr-review"
}

# Records that the uncommitted changes were reviewed, when the review's
# arguments, $1, cover them: no target, which reviews the local changes, or a
# range ending in a snapshot of this very tree. A pull request or another
# range reviews something else, so neither counts for the local changes.
#
# It also records the review of the whole pull request: a pull request by
# number or link, or a range ending at the pushed commit that starts at or
# before the merge base with a remote's default branch, which stands in for
# the PR's base. The end of the last such range is kept as reviewed-commit,
# so a review run just before a push counts once the push lands on that same
# commit. A review loop's snapshot is never the commit
# that lands, so it does not count.
record_review() {
  find_state || return 0
  cwd="$f_cwd"
  start="" target=""
  skip=no
  pr=no
  # The arguments are words to read, not patterns to expand against files.
  set -f
  for a in $1; do
    if [ "$skip" = yes ]; then skip=no; continue; fi
    case "$a" in
      low | medium | high | xhigh | max | ultra) ;;
      --max-findings) skip=yes ;;
      -*) ;;
      # A range with no end, such as HEAD.., stops at HEAD and so reads no
      # uncommitted change.
      *..) set +f; return 0 ;;
      # A link to a range inside a pull request reads part of it.
      http*..*) set +f; return 0 ;;
      *..*) start="${a%%..*}" target="${a##*..}" ;;
      # A pull request reads what was pushed to it, not the local changes.
      '#'[0-9]* | http*/pull/[0-9]* | http*/merge_requests/[0-9]*) pr=yes; break ;;
      # A branch, a commit or another URL is not the local changes.
      *[!0-9]*) set +f; return 0 ;;
      # Digits alone are a pull request's number.
      *) pr=yes; break ;;
    esac
  done
  set +f
  if [ "$pr" = yes ]; then
    mark_pr_reviewed "$(cat "$state/pr-head" 2>/dev/null)"
    return 0
  fi
  if [ -n "$target" ]; then
    top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" || return 0
    end="$(git -C "$top" rev-parse -q --verify "$target^{commit}" 2>/dev/null)"
    if [ -n "$end" ] && whole_range "$top" "$start" "$end"; then
      printf '%s\n' "$end" > "$state/reviewed-commit"
      mark_pr_reviewed "$end"
    fi
    reviewed="$(git -C "$top" rev-parse -q --verify "$target^{tree}" 2>/dev/null)" || return 0
    [ "$reviewed" = "$(worktree_tree "$top")" ] || return 0
  fi
  now="$(tree_state "$cwd")" || return 0
  printf '%s\n' "$now" > "$state/review-hash"
}

session_start() {
  contract="$root/standards/workflow.md"
  writing="$root/skills/plain-writing/SKILL.md"

  if [ ! -r "$contract" ]; then
    log "cannot read $contract, so no contract was sent"
    return 0
  fi

  text="$(cat "$contract")"

  if [ -r "$writing" ]; then
    # The Punctuation and Word choice sections, each from its heading to the
    # next one. Any section between or after them stays out.
    rules="$(awk '
      /^## / { keep = ($0 == "## Punctuation" || $0 == "## Word choice") }
      keep
    ' "$writing")"
    if [ -n "$rules" ]; then
      text="$text

The writing rules every reply follows, from the eng:plain-writing skill:

$rules"
    else
      log "found no Punctuation or Word choice section in $writing"
    fi
  else
    log "cannot read $writing, so the writing rules were not sent"
  fi

  if ! command -v jq >/dev/null 2>&1; then
    log "jq not found, so the block went out as plain text and the skill listing was not reloaded"
    printf '%s\n' "$text"
    return 0
  fi

  source="$(get .source)"
  reload=false
  [ "$source" = compact ] && reload=true

  jq -n --arg ctx "$text" --argjson reload "$reload" '{
    hookSpecificOutput: (
      {hookEventName: "SessionStart", additionalContext: $ctx}
      + (if $reload then {reloadSkills: true} else {} end)
    )
  }' || log "jq could not build the output"

  if find_state; then
    # A resume or a compaction keeps the changes the session started with.
    # Hashing a large tree here could cost the block its timeout, so the first
    # prompt hashes it instead, before the model can change anything.
    if [ "$source" = startup ] || [ "$source" = clear ] || [ ! -f "$state/start-hash" ]; then
      rm -f "$state/start-hash"
      : > "$state/start-pending"
    fi
    find "$CLAUDE_PLUGIN_DATA/sessions" -mindepth 1 -maxdepth 1 -type d -mtime +30 \
      -exec rm -rf {} + 2>/dev/null
  fi
  return 0
}

# The part of a prompt that is your own words. In a Claude project a message
# arrives wrapped with the project's routing, and a relay from the project's
# coordinator quotes yours, so only the bodies a human wrote count there.
request_text() {
  printf '%s' "$1" | jq -Rrs '
    if test("^\\s*<(wake|relay|project_claude_message)[ >]") or contains("<coordinator-relay>") then
      [ scan("<message[^>]*from=\"human\"[^>]*>([\\s\\S]*?)</message>"),
        scan("<cited[^>]*author=\"user\"[^>]*>([\\s\\S]*?)</cited>") ]
      | map(.[0]) | join("\n")
    else . end' 2>/dev/null
}

on_prompt() {
  if find_state && [ -f "$state/start-pending" ]; then
    tree_state "$f_cwd" > "$state/start-hash" 2>/dev/null || rm -f "$state/start-hash"
    rm -f "$state/start-pending"
  fi
  text="$(get .prompt)"
  lead="$(printf '%s\n' "$text" | sed -n '/[^[:space:]]/{s/^[[:space:]]*//;p;q;}')"
  # A background task or a subagent reporting back, a CI event, or another
  # session's message is not yours, so it keeps the state of the message
  # before it.
  case "$lead" in
    '<task-notification'* | '<cross-session-message'* | '<agent-message'* | '<ci-monitor-event'*) return 0 ;;
  esac
  request="$(request_text "$text")"
  # A project event no human wrote, such as CI reporting back, keeps it too.
  case "$lead" in
    '<wake '* | '<wake>'* | '<relay '* | '<relay>'* | '<project_claude_message'*) envelope=yes ;;
    *) case "$text" in *'<coordinator-relay>'*) envelope=yes ;; *) envelope=no ;; esac ;;
  esac
  if [ "$envelope" = yes ] && [ -z "$(printf '%s' "$request" | tr -d '[:space:]')" ]; then
    return 0
  fi
  if find_state; then
    printf '%s\n' "$request" > "$state/turn"
    : > "$state/skills"
    # UserPromptExpansion fires before this, so a skill typed as a slash
    # command is recorded again after the reset.
    case "$lead" in
      /*) record_skill "${lead%%[[:space:]]*}" ;;
    esac
  fi

  pr='https?://github\.com/[^/[:space:]]+/[^/[:space:]]+/pull/[0-9]+'
  if printf '%s' "$request" | grep -Eq "${pr}[^[:space:]]*#(issuecomment-|discussion_r|pullrequestreview-|r[0-9])"; then
    context UserPromptSubmit "The message links a pull request review comment. The eng:pr-feedback skill covers review feedback."
  elif printf '%s' "$request" | grep -Eq "$pr" &&
    [ -z "$(printf '%s' "$request" | sed -E "s#${pr}[^[:space:]]*##g" | tr -d '[:space:]')" ]; then
    context UserPromptSubmit "The message is a pull request link with no request. Ask what to do with it rather than starting a review."
  fi
}

on_expansion() {
  name="$(skill_name "$(get .command_name)")"
  case "${name##*:}" in
    code-review | review)
      if has_word "$(get .command_args)" "$POST_FLAGS"; then
        jq -n --arg r "The eng plugin blocks --comment and --post on a review, because nothing is posted to a pull request from here. Run it without them and the findings stay in the session; ask for a draft file of comments if you want one." \
          '{decision: "block", reason: $r}'
        return 0
      fi
      record_review "$(get .command_args)"
      ;;
  esac
  record_skill "$name"
}

# Sets $verdict to allow or deny, and $reason, for a write the eng skill named
# by $1 runs: commit, push, pr or issue. The write runs unless the user's
# latest message says not to.
gate() {
  verdict=allow
  reason=""
  case "$1" in
    commit)
      skills=commit label=commit via="the eng:commit skill"
      words='commit(s|ted|ting)?|check(ed)?( it)?[ -]?in' ;;
    push)
      skills="commit pr" label=push via="the eng:commit skill, or eng:pr when it pushes its branch"
      words='push(ed|es|ing)?' ;;
    pr)
      skills=pr label="pull request change" via="the eng:pr skill"
      words='prs?|pull[ -]requests?|merge[ -]requests?|mrs?' ;;
    *)
      skills=issue label="issue change" via="the eng:issue skill"
      words='issues?|tickets?' ;;
  esac
  if [ -n "$f_agent" ]; then
    verdict=deny
    reason="A subagent never commits, pushes, changes a pull request or writes an issue. Hand the work back to the main session."
    return 0
  fi
  # With no state to read, the gate fails open like the rest of the hook.
  find_state && [ -f "$state/turn" ] || return 0
  loaded=no
  for s in $skills; do
    grep -qx "$s" "$state/skills" 2>/dev/null && loaded=yes
  done
  if [ "$loaded" = no ]; then
    verdict=deny
    reason="Load $via with the Skill tool first. It runs this $label, and checks that the user's latest message wants one."
    return 0
  fi
  if said_no "$words"; then
    verdict=deny
    reason="The user's latest message says not to do this $label. Do not run it. Say why you stopped, and go on with the rest."
  fi
}

# True when the user's latest message says not to do a write named by the
# extended regex $1. The hook only catches a plain no, and leaves anything
# subtler to the skills, which read meaning rather than words.
#
# A no is a negation right before the write, with nothing between them but
# small words or a list of writes, and nothing after it but the end of the
# clause or a word such as "it", "yet" or "until": "don't push", "no PR",
# "don't stage, commit or push", "commit without pushing", "hold the push",
# "never mind the push", "I'll push it myself", "don't push yet, okay?". A
# deferral right after the write counts too: "push it later", "push once I
# approve". So "don't commit the .env file" and "don't push to
# main" narrow the write rather than refuse it.
#
# A report is not a no: "it didn't push", "I can't commit", "it won't push",
# "if you can't push" and a past form such as "not pushed" state a fact, and
# "no, you push it" answers rather than refuses.
#
# The places the message names the write are read from the last one back. One
# inside a no refuses the write. One that opens a request asks for it: after a
# stop, a comma, a dash, "please", "can you", "then" or the like,
# perhaps followed by "you" or a verb such as "open a new" or "retry the", or
# after "you should" outside a condition. In a sentence after the no, a mention
# right after a word that asks, such as "go", "let's", "actually", "time to"
# or "open the", asks too, unless it only names the write ("when to push", "Sam will
# open the PR"). So "I didn't push it, can you push", "don't push. Actually,
# push it" and "don't push yet. OK, go push" ask for the push, while "Don't
# open a PR. The PR template is broken" does not. Any other mention passes to
# the one before it. A plain list joined by "and" after a negation that tells,
# as in "don't commit and push", refuses every write in it.
#
# A question drops out: the whole sentence when it opens with a question word,
# so "why don't you push, then?" refuses nothing, and otherwise back to its
# last comma, so "don't push, why did CI fail?" still refuses. "There's no PR
# yet" states a fact. A takeback, a wait or a condition, such as "actually,
# just commit", "commit and push. Not yet" or "let me review first", is left
# to the skills.
said_no() {
  target="($1)"
  text="$(tr '[:upper:]' '[:lower:]' < "$state/turn" | tr '\n\t' '  ' |
    sed -E "s/(don[^a-z ]{0,3}t|do not|never) forget( about)? (to |the |a |an )?/\\3/g; s/whether or not /whether /g" |
    awk '{ n = split($0, part, /[?]/); out = ""
      for (i = 1; i <= n; i++) {
        s = part[i]
        if (i < n) {
          k = 0; for (j = length(s); j > 0; j--) if (substr(s, j, 1) ~ /[.!;]/) { k = j; break }
          q = substr(s, k + 1); sub(/^ +/, "", q)
          if (q !~ /^(why|what|how|where|when|who|which|can|could|would|will|should|shall|is|are|was|were|does|did|any)([^a-z]|$)/)
            for (j = length(s); j > k; j--) if (substr(s, j, 1) == ",") { k = j; break }
          s = substr(s, 1, k)
        }
        out = out s " " }
      print out }' |
    sed -E "s/(there[^a-z ]{0,3}s|there is|there are|there was|we have|we[^a-z ]{0,3}ve got|i have) no (((a|an|the) )?($WRITE_WORDS)[^a-z0-9_-])/\\1 zero \\2/g; s/(^|[^a-z])no,? (you|i|we|it|that|this) /\\1nope \\2 /g; s/(^|[^a-z])(it|that|this|ci|git|the hook|the branch)( won[^a-z ]{0,3}t| wont| did not| does not| will not| is not|[^a-z ]{1,3}s not)( even| really| actually)? +(($WRITE_WORDS)[^a-z0-9_-])/\\1\\2 failed to \\5/g; s/(^|[^a-z])if you (can[^a-z ]{0,3}t|cannot|can not) /\\1if you fail to /g; s/(^|[^a-z])no ((a |an |the )?($WRITE_WORDS)( yet)?( for [a-z]+)?[ ,;.:!-]+(ok,? |so |please |just |now |go |then |let.?s |go ahead and )?(open|make|file|create|raise) (one|it|a new))/\\1zero \\2/g; s/(^|[^a-z])why (don[^a-z ]{0,3}t you|not) /\\1/g")"
  q='[^a-z ]?[^a-z ]?[^a-z ]?'
  # Only a negation that tells: "didn't", "wasn't" or "I can't" report a fact,
  # as in "it didn't push, push again", while "you can't push" tells. A report
  # about the tool, such as "it won't push" or "it's not pushing", was turned
  # into "it failed to push" above.
  neg="(you (can${q}t|cannot|can not|may not|must not)|don${q}t|won${q}t|shouldn${q}t|mustn${q}t|needn${q}t|dont|wont|shouldnt|mustnt|neednt|do not|never|not|no|no need (to|for)|without|refrain from|avoid|wait (before|on|with))"
  # The negations that also refuse a list joined by "and", as in "don't commit
  # and push". "No" and "without" do not, so "no PR and push it" asks for the
  # push.
  tell="(you (can${q}t|cannot|can not|may not|must not)|don${q}t|won${q}t|shouldn${q}t|mustn${q}t|needn${q}t|dont|wont|shouldnt|mustnt|neednt|do not|never|avoid|refrain from)"
  # Words that drop the write, or keep it for yourself, reach it only across
  # small words, so "I'll leave it to you to push" asks for the push.
  drop="(i${q}ll|i will|hold( off)?( on)?|leave|never ?mind( about)?|forget( about)?|scratch|scrap|cancel|drop|skip) +((the|a|an|my|your|our|any|this|that|these|those|it|do|handle|open|create|file|make|raise|submit|update|edit|close|reopen) +)*"
  # A list of writes is refused as a whole when it ends in "or" or "nor", as
  # in "don't stage, commit or push", or, after one of the $tell negations,
  # when it is joined by "and", as in "don't commit and push". So "skip the PR
  # and push" or "no PR, push it" still asks for the push.
  list="(($WRITE_WORDS), +)*($WRITE_WORDS),? (or|nor) +"
  gap="(((the|a|an|any|my|your|our|this|that|these|those|it|ever|again|even|or|nor|to|want|you|open|create|raise|make|submit|update|edit|close|reopen|file|touch|run|use|git|gh|glab|handle|do|need|you dare|ready to) +)|$list)*"
  end="( *[^a-z0-9_ -]| *$| +-+ | +(it|this|that|them|yet|now|anything|anymore|either|again|until|unless|before|under|for|at all|or|and|nor|please|myself|yourself|till|today|alone|to me|needed|necessary|(the|your|my|our|any|these|those) (changes?|work|code|branch|prs?|commits?))[^a-z0-9_-])"
  later="(,? +(it|this|that|them))?,? +(later|tomorrow|not yet|not now|once i|after i|until i|till i|when i say)[^a-z]"
  # A long dash also opens a request. It is written as bytes, since the repo
  # holds no dash characters.
  long="$(printf '\342\200\224')"
  # An opener, then perhaps a verb that asks, as in ", open a new PR" or
  # ". You push it". A verb with no opener, as in "Sam will open the PR", asks
  # for nothing.
  opener="(^ *|[.;:!,] *|[^a-z]-+ *|$long *|[^a-z](please|can you|could you|go ahead and|now|then|so|just|and|you can|feel free to|need you to|want you to) +)"
  cue="$opener((you|retry|redo|try|open|create|make|raise|file|edit|update|recommit|re-?push) +((a|an|the|new|this|that|it|to|existing|old|current|same) +)*)?\$"
  printf ' %s \n' "$text" | awk -v target="$target" \
    -v r1="[^a-z]($neg +$gap|$drop)$target$end" -v r2="[^a-z0-9_-]$target$later" \
    -v r3="[^a-z]($neg +$gap|$drop)$list($WRITE_WORDS)$end" \
    -v r4="[^a-z]$tell +(($WRITE_WORDS) +(and|or|nor) +)+($WRITE_WORDS)$end" -v cue="$cue" '
    function spans(s, r,   pos, m) {
      pos = 1
      while (pos <= length(s) && match(substr(s, pos), r)) {
        m = pos + RSTART - 1; n++; from[n] = m; to[n] = m + RLENGTH - 1; pos = m + 1 }
    }
    {
      s = $0; n = 0; k = 0
      # r3 and r4 cover every write in a refused list, the first ones too:
      # "do not stage, commit or push", "do not commit and push".
      spans(s, r1); spans(s, r2); spans(s, r3); spans(s, r4)
      pos = 1; w = "[^a-z0-9_-]" target "[^a-z0-9_-]"
      while (pos <= length(s) && match(substr(s, pos), w)) { k++; at[k] = pos + RSTART; pos = at[k] }
      for (j = k; j > 0; j--) {
        # A past form, such as "pushed", reports rather than asks or refuses.
        if (substr(s, at[j], 40) ~ /^[a-z-]*ed[^a-z]/) continue
        for (i = 1; i <= n; i++) if (at[j] > from[i] && at[j] <= to[i]) exit 0
        # A mention that opens a request asks for the write, and so does one
        # right after a word that asks in a later sentence than a no, unless
        # it only names the write, as in "when to push" or "Sam will open the
        # PR".
        head = substr(s, 1, at[j] - 1)
        if (head ~ cue) exit 1
        if (head ~ /[^a-z]you +(should|could|can|may|might|will|would|need to|have to|must) +$/ &&
          head !~ /(until|till|when|unless|before|after|once|if) [^.;!,]*$/) exit 1
        if (head ~ /[^a-z](go|let.?s|time to|ok|okay|do|go ahead and|actually|jk|we can|you can|thought|i want you to|now|open|create|make|raise|file|update|edit|submit|retry|redo)( +(a|an|the|new|this|that|it))* +$/ &&
          head !~ /(when|whether|how|where|what) +to +([a-z]+ +)?((the|a|an|this|that|new) +)*$/ &&
          head !~ /(will|would|[^a-z ]ll|could|should|might|may) +([a-z]+ +)?((the|a|an|this|that|new) +)*$/) {
          # Only in a sentence after the no.
          for (i = 1; i <= n; i++) if (to[i] < at[j] && substr(s, to[i], at[j] - to[i]) ~ /[.;!]/) exit 1
        }
      }
      exit 1
    }'
}

# Prints what an MCP tool writes, in the parser's form, from its name split
# into words.
mcp_tool() {
  rest="${1#mcp__}"
  server="${rest%%__*}"
  name="${rest#*__}"
  # The Claude app's own servers carry its chat, panes and settings. The
  # terminal tool that runs a command is read as a shell command instead.
  case "$1" in
    mcp__ccd_pr__set_auto_merge) printf 'confirm %s\n' "$1"; return 0 ;;
  esac
  case "$server" in
    hearthbot | claude-code-remote | ccd_* | visualize | Claude_Browser | claude-in-chrome | \
      terminal | scheduled-tasks | Claude_Code_iOS_Simulator | ide) return 0 ;;
  esac
  # createPRReview splits into create, PR and Review.
  words=" $(printf '%s' "$name" | sed 's/\([a-z0-9]\)\([A-Z]\)/\1 \2/g; s/\([A-Z]\)\([A-Z][a-z]\)/\1 \2/g' |
    tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' ' ') "
  # Making a draft is not a write, since you send it yourself. Sending,
  # deleting, publishing or scheduling one is.
  case "$words" in
    *" pull request "* | *" merge request "*) ;;
    # Publishing a draft note on GitLab posts it.
    *" publish draft note "* | *" publish draft notes "*) printf 'post %s\n' "$1"; return 0 ;;
    *" draft "* | *" drafts "*)
      # Slack's send_message_draft only makes a message draft.
      case "$words" in *" message draft "*) return 0 ;; esac
      for v in send delete publish schedule; do
        case "$words" in *" $v "*) printf 'confirm %s\n' "$1"; return 0 ;; esac
      done
      return 0 ;;
  esac
  # The first word that reads or writes decides, so get_commit and
  # comments_list read and delete_list writes. A read joined to a write, as in
  # get_or_create, writes.
  first=""
  for w in $(printf '%s' "$words" | sed 's/ pull request / pull_request /g; s/ merge request / merge_request /g'); do
    case " $READS $WRITES " in *" $w "*) first="$w"; break ;; esac
  done
  case " $READS " in
    *" $first "*)
      for v in $WRITES $POSTS; do
        case "$words" in *" or $v "* | *" and $v "*) first="$v" ;; esac
      done ;;
  esac
  # An HTTP-shaped name such as API-post-search reads when it searches.
  case "$first" in
    post) case "$words" in *" search "* | *" query "*) return 0 ;; esac ;;
  esac
  case " $READS " in *" $first "*) return 0 ;; esac
  # Sending or posting a message, a DM or a chat line is a post. In a chat
  # service, adding or writing one is too, and Slack's and Teams' own tool
  # names say so even under a connector named by an id.
  case "$words" in
    *" conversations add message "* | *" create chat message "* | *" create channel message "*)
      printf 'post %s\n' "$1"; return 0 ;;
  esac
  case "$words" in
    *" send "* | *" post "* | *" schedule "*)
      case "$words" in
        *" message "* | *" messages "* | *" dm "* | *" chat "*) printf 'post %s\n' "$1"; return 0 ;;
      esac ;;
  esac
  case "$server" in
    *[Ss]lack* | *[Tt]eams* | *[Dd]iscord* | *[Cc]hat* | *[Zz]ulip* | *[Mm]attermost* | \
      *[Ww]hats[Aa]pp* | *[Tt]elegram* | *[Ii]ntercom* | *[Ww]ebex*)
      case "$words" in
        *" add message "* | *" add messages "* | *" create message "* | *" create messages "* | *" write message "* | *" chat write "* | *" create post "* | *" create posts "*)
          printf 'post %s\n' "$1"; return 0 ;;
      esac ;;
  esac
  # A note or discussion on a merge request or an issue is a comment, and so
  # is resolving a review thread.
  case "$words" in
    *" note "* | *" notes "* | *" discussion "* | *" thread "*)
      case "$words" in
        *" merge request "* | *" issue "* | *" mr "*) printf 'post %s\n' "$1"; return 0 ;;
      esac
      # GitLab calls a comment a note, but release notes are not comments.
      case "$server:$words" in
        *[Gg]it[Ll]ab*:*" release "*) ;;
        *[Gg]it[Ll]ab*:*) printf 'post %s\n' "$1"; return 0 ;;
      esac ;;
  esac
  case "$words" in
    *" resolve "*)
      case "$words" in *" thread "* | *" discussion "* | *" comment "*) printf 'post %s\n' "$1"; return 0 ;; esac ;;
  esac
  # A git server's commit and push are the same writes as the git commands.
  case "$words" in
    *" git commit "* | *" commit changes "*) printf 'gate commit\n'; return 0 ;;
    *" git push "*) printf 'gate push\n'; return 0 ;;
  esac
  # Asking for a review is not posting one. "pull request" and "merge request"
  # are nouns, not that.
  case "$(printf '%s' "$words" | sed 's/ pull request / pull_request /g; s/ merge request / merge_request /g')" in
    *" request "*) ;;
    *)
      for w in $POSTS; do
        case "$words" in *" $w "*) printf 'post %s\n' "$1"; return 0 ;; esac
      done
      # A reaction, but not React the library.
      case "$words" in
        " react " | *" react to "* | *" emoji react "* | *" react message "* | *" message react "* | *" react comment "*)
          printf 'post %s\n' "$1"; return 0 ;;
      esac ;;
  esac
  # A claude.ai connector's server is named by an id, so GitHub's own words
  # in the tool's name count too.
  github=no
  case "$server" in *[Gg]it[Hh]ub*) github=yes ;; esac
  case "$words" in *" pull request "* | *" push files "* | *" or update file "*) github=yes ;; esac
  case "$github" in
    yes)
      # Pushing files, or writing one, commits straight to the remote.
      case "$words" in
        *" push "* | *" file "* | *" files "*) printf 'gate push\n'; return 0 ;;
        *" create branch "* | *" create ref "* | *" update ref "*) printf 'gate push\n'; return 0 ;;
      esac
      for v in create update add remove edit close reopen delete set assign write convert reprioritize; do
        case "$words" in *" $v "*) ;; *) continue ;; esac
        case "$words" in
          *" issue "* | *" issues "* | *" label "* | *" labels "* | *" milestone "* | *" sub "*)
            printf 'gate issue\n'; return 0 ;;
          *" pull request "* | *" pr "*)
            case "$v" in create | update | edit | convert) printf 'gate pr\n'; return 0 ;; esac ;;
        esac
      done ;;
  esac
  for v in $WRITES; do
    case "$words" in *" $v "*) printf 'confirm %s\n' "$1"; return 0 ;; esac
  done
}

# The guard on a code-review the model calls, under whatever namespace.
skill_call() {
  name="$(skill_name "$(get .tool_input.skill)")"
  case "${name##*:}" in code-review | review) ;; *) return 0 ;; esac
  args="$(get .tool_input.args)"
  if has_word "$args" "$POST_FLAGS"; then
    decision deny "$POST_REASON"
  elif has_word "$args" 'ultra|--fix(=[^[:space:]]*)?'; then
    decision deny "Run code-review at an explicit level such as high, without ultra or --fix, and apply its findings yourself."
  fi
}

on_pre_tool() {
  tool="$f_tool"
  case "$tool" in
    Bash | Monitor | PowerShell | mcp__terminal__run_in_terminal)
      command="$(get .tool_input.command)"
      [ -n "$command" ] || return 0
      if ! found="$(printf '%s' "$command" | awk -f "$root/hooks/classify-command.awk")"; then
        log "the command parser failed"
        return 0
      fi ;;
    Skill) skill_call; return 0 ;;
    mcp__*) found="$(mcp_tool "$tool")" ;;
    *) return 0 ;;
  esac
  [ -n "$found" ] || return 0
  case "$tool" in Bash) note_push ;; esac

  # Tiers apply in order: a post is denied outright, and a push the write gate
  # allows still asks when it forces, deletes or pushes tags.
  deny="" ask=""
  while IFS= read -r line; do
    kind="${line%% *}"
    what="${line#* }"
    case "$kind" in
      post) [ -n "$deny" ] || deny="$POST_REASON" ;;
      gate)
        gate "$what"
        [ "$verdict" = deny ] && [ -z "$deny" ] && deny="$reason" ;;
      confirm) ask="${ask:+$ask }This can write outside this machine: $what. Confirm it." ;;
    esac
  done <<EOF
$found
EOF
  if [ -n "$deny" ]; then
    decision deny "$deny"
  elif [ -n "$ask" ]; then
    decision ask "$ask"
  fi
}

# Prints the remote branches that point at HEAD in the repo at $1, one per
# line, leaving out each remote's default branch, which no pull request is
# opened from. Where a remote names no default, main and master stand in.
pushed_refs() {
  git -C "$1" for-each-ref --points-at HEAD --format='%(refname)' refs/remotes/ 2>/dev/null |
    while IFS= read -r ref; do
      rest="${ref#refs/remotes/}"
      remote="${rest%%/*}"
      branch="${rest#*/}"
      [ "$branch" = HEAD ] && continue
      default="$(git -C "$1" symbolic-ref -q "refs/remotes/$remote/HEAD" 2>/dev/null)"
      if [ -n "$default" ]; then
        [ "$ref" = "$default" ] && continue
      else
        case "$branch" in main | master) continue ;; esac
      fi
      printf '%s\n' "$ref"
    done
}

# Before a push or a pull request command, which the classifier named in
# $found, keeps the command, its kind and where every remote branch stood,
# so the post-tool hook can tell what it moved, even when the same command
# also commits. Opening a pull request, which the classifier names with
# "open pr", needs its branch pushed, not moved.
note_push() {
  [ -z "$f_agent" ] || return 0
  printf '%s\n' "$found" | grep -Eqx 'gate (push|pr)' || return 0
  kind=push
  printf '%s\n' "$found" | grep -qx 'open pr' && kind=open
  find_state || return 0
  # Outside a repo there is nothing to compare against afterwards.
  if ! top="$(git -C "$f_cwd" rev-parse --show-toplevel 2>/dev/null)"; then
    rm -f "$state/push-pending"
    return 0
  fi
  {
    printf '%s\n' "$kind"
    printf '%s' "$command" | git hash-object --stdin 2>/dev/null
    printf '%s\n' "$top"
    git -C "$f_cwd" for-each-ref --format='%(objectname) %(refname)' refs/remotes/ 2>/dev/null
  } > "$state/push-pending"
}

# After the command note_push kept, records HEAD as the commit to review as a
# pull request: a push that moved a remote branch to it, or a pull request
# opened on a branch already there. A push that moved only tags, a deletion
# or the default branch moves no such branch, and records nothing. The refs
# decide a push, not the exit status, because a command can fail after its
# push landed. A pull request that failed to open counts only when its
# command's push moved a branch.
record_push() {
  # Most commands push nothing, so look for the file before touching state.
  [ -f "$(state_path)/push-pending" ] || return 0
  find_state || return 0
  pending="$(cat "$state/push-pending" 2>/dev/null)"
  ran="$(get .tool_input.command)"
  [ "$(printf '%s\n' "$pending" | sed -n 2p)" = "$(printf '%s' "$ran" | git hash-object --stdin 2>/dev/null)" ] || return 0
  rm -f "$state/push-pending"
  kind="$(printf '%s\n' "$pending" | sed -n 1p)"
  # A command that changed directory is judged in the repo it started in.
  [ "$(printf '%s\n' "$pending" | sed -n 3p)" = "$(git -C "$f_cwd" rev-parse --show-toplevel 2>/dev/null)" ] || return 0
  head="$(git -C "$f_cwd" rev-parse -q --verify HEAD 2>/dev/null)" || return 0
  after="$(pushed_refs "$f_cwd")"
  [ -n "$after" ] || return 0
  if [ "$kind" != open ] || [ "$f_event" = PostToolUseFailure ]; then
    before="$(printf '%s\n' "$pending" | sed '1,3d')"
    moved=no
    for ref in $after; do
      printf '%s\n' "$before" | grep -qxF "$head $ref" || moved=yes
    done
    [ "$moved" = yes ] || return 0
  fi
  printf '%s\n' "$head" > "$state/pr-head"
  # A review of the whole range ending here, run before the push, covers it.
  mark_pr_reviewed "$(cat "$state/reviewed-commit" 2>/dev/null)"
}

on_post_tool() {
  case "$f_tool" in
    # A skill a subagent loads leaves the main session's gate as it was.
    Skill)
      [ -n "$f_agent" ] && return 0
      name="$(skill_name "$(get .tool_input.skill)")"
      # A review that ran, as opposed to one that was asked for and refused.
      case "${name##*:}" in code-review | review) record_review "$(get .tool_input.args)" ;; esac
      record_skill "$name" ;;
    Bash)
      # A merge that stops on a conflict exits 1, which fires
      # PostToolUseFailure with the output in error rather than PostToolUse.
      event="$f_event"
      # A subagent never pushes.
      [ -z "$f_agent" ] && record_push
      if printf '%s' "$input" | jq -r '(.error // empty), (.tool_response // empty
          | if type == "object" then [.stdout, .stderr] | map(. // "") | join("\n") else tostring end)' 2>/dev/null |
        grep -Eq 'CONFLICT \(|Automatic merge failed|Merge conflict in|could not apply'; then
        context "${event:-PostToolUse}" "Git reported a conflict. When the user's latest message asks for this operation, the eng:merge-conflicts skill resolves it."
      fi ;;
  esac
}

on_stop() {
  # Once per turn: a stop this hook already continued passes.
  [ "$(get .stop_hook_active)" = true ] && return 0
  # A code-review still running in the background reports back later.
  if printf '%s' "$input" | jq -e '[.background_tasks[]?
      | select((.status // "running") | test("^(running|pending)$"))
      | ((.description // "") + " " + (.agent_type // ""))
      | select(test("code.?review"; "i"))] | length > 0' >/dev/null 2>&1; then
    return 0
  fi
  find_state || return 0
  now="$(tree_state "$f_cwd")" || return 0
  if [ "$now" != clean ] && [ "$now" != "$(cat "$state/start-hash" 2>/dev/null)" ] &&
    [ "$now" != "$(cat "$state/review-hash" 2>/dev/null)" ]; then
    context Stop "$REVIEW_REMINDER"
    return 0
  fi
  # The pushed commit, once, while HEAD is still on it and no review reached it.
  pushed="$(cat "$state/pr-head" 2>/dev/null)" || return 0
  [ -n "$pushed" ] || return 0
  [ "$pushed" = "$(cat "$state/pr-review" 2>/dev/null)" ] && return 0
  [ "$pushed" = "$(cat "$state/pr-reminded" 2>/dev/null)" ] && return 0
  [ "$pushed" = "$(git -C "$f_cwd" rev-parse -q --verify HEAD 2>/dev/null)" ] || return 0
  printf '%s\n' "$pushed" > "$state/pr-reminded"
  context Stop "$PR_REMINDER"
}

input="$(cat)"
# The fields most modes read, parsed once.
f_sid="" f_cwd="" f_agent="" f_tool="" f_event=""
if command -v jq >/dev/null 2>&1; then
  # tostring keeps every value one quoted word, whatever its JSON type.
  eval "$(printf '%s' "$input" | jq -r '@sh "f_sid=\(.session_id // "" | tostring) f_cwd=\(.cwd // "" | tostring) f_agent=\(.agent_id // "" | tostring) f_tool=\(.tool_name // "" | tostring) f_event=\(.hook_event_name // "" | tostring)"' 2>/dev/null)"
fi
case "$mode" in
  session-start) session_start ;;
  prompt | expansion | pre-tool | post-tool | stop)
    if ! command -v jq >/dev/null 2>&1; then
      log "jq not found, so the $mode hook did nothing"
      exit 0
    fi
    case "$mode" in
      prompt) on_prompt ;;
      expansion) on_expansion ;;
      pre-tool) on_pre_tool ;;
      post-tool) on_post_tool ;;
      stop) on_stop ;;
    esac ;;
  *) log "unknown mode '$mode'" ;;
esac
exit 0
