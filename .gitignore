node_modules/
.DS_Store

# A global ignore of .claude/ (see the README setup) would hide this repo's
# own rules. Un-ignore that one directory and nothing else, so worktree
# checkouts and local settings stay out.
!.claude/
.claude/*
!.claude/rules/

# A local choice of which skills to link, per machine. A fork that wants the
# same subset everywhere can commit it with `git add -f .skillsignore`.
.skillsignore

# Skill exports. The clone is the source; a zip beside it is a second
# copy that drifts.
*.zip
