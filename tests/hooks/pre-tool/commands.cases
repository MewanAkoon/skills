zsh -lc "cd repo && gh issue comment 5 -b x"
== deny
eval "gh pr comment 5 -b x"
== deny on a later line
git status
gh pr comment 5 -b x
== deny in a subshell
(cd repo && gh pr comment 5 -b x)
== deny after a negation
! gh pr review 5 --approve
