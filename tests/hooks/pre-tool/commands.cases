# Shell commands and what the pre-tool hook decides for each. A line
# "== <deny|ask|allow> <note>" starts a case, and every line after it up to
# the next such line is the command, newlines and all. Lines before the first
# case are these notes.
#
# The first 42 cases are the old block-pr-comments.sh battery. The state for
# every case has eng:commit, eng:pr and eng:issue loaded and a message asking
# for all of them, so each result is what the post guard and the confirmation
# prompt decide. The write gate has its own cases in scripts/test-hooks.sh.
== deny posting
gh pr comment 5 --body "hi"
== deny
gh pr review 5 --approve --body "lgtm"
== deny
gh issue comment 5 -b x
== deny
gh pr comment 5 --body "$(cat draft.md)"
== deny
gh api --method POST /repos/o/r/issues/5/comments -f body=hi
== deny
gh api -X POST /repos/o/r/pulls/5/reviews -f event=APPROVE
== deny
gh api /repos/o/r/issues/5/comments -f body=hi
== deny
gh api --method PATCH /repos/o/r/issues/comments/99 -f body=edited
== deny
curl -X POST https://api.github.com/repos/o/r/issues/5/comments -d {"body":"hi"}
== deny
gh pr close 5 --comment "superseded"
== deny
gh pr reopen 5 --comment "back"
== deny reached indirectly
git status && gh pr comment 5 -b x
== deny
npm test; gh issue comment 5 -b x
== deny
timeout 30 gh pr comment 5 -b x
== deny
GH_TOKEN=abc gh pr comment 5 -b x
== deny
sh -c "gh pr comment 5 -b x"
== deny
bash -c 'gh pr review 5 --approve'
== allow reading
gh pr view 5
== allow
gh pr view 5 --comments
== allow
gh api /repos/o/r/issues/5/comments
== allow
gh api /repos/o/r/pulls/5/reviews --paginate
== allow
gh api --method GET /repos/o/r/issues/5/comments -f per_page=100
== allow
gh api /repos/o/r/pulls/5/comments --jq ".[].body"
== allow
curl -s https://api.github.com/repos/o/r/issues/5/comments
== allow other git and gh writes, asked for and with the skill loaded
git commit -m "x"
== allow
git push origin main
== allow
git checkout -b feature/x
== allow
git push -u origin feature/x
== allow
gh pr create --title x --body y
== allow
gh pr edit 5 --body y
== ask merging was allowed by the old guard and now always asks
gh pr merge 5
== ask closing too
gh pr close 5
== allow
gh api --method POST /repos/o/r/pulls -f title=x
== allow text about the rule
grep -rn 'gh pr comment' ~/.claude
== allow
rg 'gh api .* /comments' docs/
== allow
printf "gh pr comment 5 -b x\n" >> notes.md
== allow
echo "run: gh api --method POST /repos/o/r/issues/5/comments -f body=x" > example.txt
== allow a heredoc body is data
cat > doc.md <<EOF
Never run gh pr comment 5 --body "x".
Never run gh api --method POST /repos/o/r/issues/5/comments -f body=x.
EOF
== allow
sed -i "" "s/gh pr comment/gh pr view/" script.sh
== allow unrelated
./scripts/check.sh --doctor
== allow
npm test
== allow
ls -la
== deny closing an issue with a comment posts it
gh issue close 5 --comment "fixed in #6"
== deny
gh issue reopen 5 -c "back"
== deny
gh pr close 5 --comment=superseded
== deny graphql comment and review mutations
gh api graphql -f query='mutation { addComment(input: {subjectId: "x", body: "hi"}) { clientMutationId } }'
== deny
gh api graphql -F query=@review.graphql -f query='mutation { addPullRequestReviewThreadReply(input: {}) { comment { id } } }'
== deny
gh api graphql -f query='mutation { resolveReviewThread(input: {threadId: "x"}) { thread { id } } }'
