#!/bin/sh
# Hook entry point for the eng plugin. hooks/hooks.json runs it as
#
#   eng-hook <mode>
#
# with the hook's JSON input on stdin, one mode per event:
#
#   session-start  SessionStart. Sends the workflow contract and the
#                  Punctuation and Word choice sections of plain-writing, read
#                  from the plugin's own files at run time. On a compaction it
#                  also asks Claude Code to load the skill listing again, which
#                  compaction drops.
#   prompt         UserPromptSubmit. Keeps your latest message for the write
#                  gate, records a grant when it approves a plan file waiting
#                  in .claude/plans, and adds a hint when it is a pull
#                  request link.
#   expansion      UserPromptExpansion. Records a skill you type, blocks
#                  /code-review with --comment or --post, and records the
#                  tree a review you type will read.
#   pre-tool       PreToolUse. The post guard, the write gate and the
#                  confirmation prompt for shell commands and MCP tools, and
#                  the guard on a code-review the model calls, and the checks
#                  on a push or a new pull request under a grant. Before a
#                  push or a pull request command, keeps where the remote
#                  branches stood.
#   post-tool      PostToolUse and PostToolUseFailure. Records a skill that
#                  loaded and a push that moved a remote branch to HEAD, and
#                  adds a hint when git reports a conflict.
#   stop           Stop. The review gate, and the reminder to review the
#                  whole pull request after a push, which under a grant
#                  blocks the stop.
#
# State lives in ${CLAUDE_PLUGIN_DATA}/sessions/<session>/, which survives
# plugin updates: turn (the text of your latest message), skills (those loaded
# since), start-hash (the uncommitted changes when the session started) and
# review-hash (the same when a review covering them last ran), push-pending.*
# (one per push or pull request command about to run, named by its tool call,
# with where every remote branch stood before it), reviewed-commit (the end of
# the last range that read the whole pull request),
# pr-head (the commit the last push or new pull request left on a remote
# branch), pr-review (that commit, once a review reached it), pr-reminded
# (that commit, once the stop gate asked for its review), started (when the
# session started, for dating plan files), reviewed-tree (the last tree a
# review at high or above ended in, when it was the working tree and the range
# changed something), grant (the approved plan's branch, name, file, start
# commit and time) and grant-pushes (the pushes made under it). The grant and
# each write under it are also logged to grant-writes.log in
# ${CLAUDE_PLUGIN_DATA}. It is not read from the transcript, which Claude
# Code writes asynchronously. Where the state cannot
# be read, the write gate allows.
#
# Every failure exits 0, so a broken hook never stops a session. Each check
# fails open and lets the tool run, except the command parser. When it fails
# on a shell command, or runs past PARSE_SECONDS below, the hook reads what the
# parser printed before it stopped: a post there is still denied, and so is a
# write the gate refuses. Anything else asks, because the command may post or
# write. The limit sits below the hook's timeout in hooks/hooks.json, so Claude
# Code does not stop the hook first and run the command unread. A failure,
# though not a timeout, is written to eng-hook.log in ${CLAUDE_PLUGIN_DATA},
# which check.sh --doctor reads and stats.mjs counts, and cut to its last 1000
# lines once it passes 2000. A hook stopped by a signal exits 143 instead.
# Needs jq. Without it the session block goes out as plain text, which Claude
# Code also takes as context, and every other mode does nothing.

set -u

# The tree hash's temp files go when the hook ends, and when Claude Code stops
# it with TERM, once the git command running then has finished. A hook killed
# outright, or a hash run inside $( ), which sets these in a subshell where
# the trap cannot see them, can leave files behind, so session start also
# removes any over a day old.
ts_list="" wt_index=""
trap 'rm -f "$ts_list" "$wt_index"' EXIT
trap 'exit 143' TERM INT HUP

mode="${1:-}"
root="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
input=""
state=""

# The seconds the command parser may take, below the PreToolUse timeout in
# hooks/hooks.json, which check.sh holds above it. Past this the hook stops
# the parser and asks, rather than letting Claude Code stop the hook and run
# the command unread. ENG_HOOK_PARSE_SECONDS can only lower it, for tests.
PARSE_SECONDS=5

# The code-review flags that post to a pull request.
POST_FLAGS='--comment(=[^[:space:]]*)?|--post(=[^[:space:]]*)?'

POST_REASON="Posting a comment, review or reply is off limits in this setup, and \
no approval releases it. Write the draft to a file with the command that would \
post it, give the user the path, and say that is why. Reading stays open."

# The words in a message that name a write. A refusal such as "don't stage,
# commit or push" may list several before the one it refuses.
WRITE_WORDS='commit(s|ted|ting)?|push(ed|es|ing)?|stag(e|ed|ing)|check(ed)?( it)? ?in|prs?|pull[ -]requests?|merge[ -]requests?|mrs?|issues?|tickets?'
# The words for each write the gate reads a no to, one at a time.
COMMIT_WORDS='commit(s|ted|ting)?|check(ed)?( it)?[ -]?in'
PUSH_WORDS='push(ed|es|ing)?'
PR_WORDS='prs?|pull[ -]requests?|merge[ -]requests?|mrs?'
ISSUE_WORDS='issues?|tickets?'

# The words in an MCP tool's name that say what it does: it reads, it posts,
# or it writes somewhere else. A write either edits, which Claude Code's own
# permission settings decide, or is risky, which the hook asks about every
# time: it deletes, moves, shares, sends, publishes, merges, deploys, runs or
# stops something, or changes who has access.
READS="read get list search fetch view retrieve query find lookup download \
describe count inspect show summarize analyze"
POSTS="comment comments reply review reviews reaction reactions approve"
EDITS="create update set append insert edit write add save duplicate generate \
batch upsert patch rename copy import convert modify reprioritize star unstar \
dismiss mark transition"
RISKY="delete apply execute deploy merge upload send post publish share unshare \
trash remove clear move submit assign close reopen archive unarchive push \
commit fork schedule request forward run invoke trigger dispatch restore drop \
purge cancel reset invite enable disable rerun revoke grant destroy terminate \
stop kill rollback restart scale reboot shutdown manage subscribe unsubscribe \
follow unfollow unpublish deactivate erase wipe suspend uninstall disconnect"
WRITES="$EDITS $RISKY"
# The words in a name that ask like a risky verb, beside any verb not in
# READS: access, money, deployments, releases, secrets, tokens, variables,
# repos, webhooks and calendars, which reach other people or cost something
# even when the verb only creates or updates.
NOUNS="permission permissions access member members collaborator collaborators \
role roles sharing refund refunds payment payments charge charges payout \
payouts invoice invoices deployment deployments release releases secret \
secrets gist gists repository repositories repo webhook webhooks calendar \
meeting meetings transfer transfers token tokens variable variables"

REVIEW_REMINDER="There are uncommitted changes that have not been reviewed since \
they last changed. If this hands back finished work, run the review step in \
eng:implement first. If you are stopping to ask a question or report a blocker, \
say so and end the turn."

PR_REMINDER="This branch was pushed, or its PR opened, since the PR was last \
reviewed as a whole. Before handing back, check whether the branch has an open \
PR. If it has none, say nothing of this and end the turn. If it has one, \
review the whole PR as step 6 of the workflow says: /code-review high on the \
range from the merge base with the PR's base branch to HEAD, then judge the \
findings and fix the valid ones through eng:implement, whose review loop \
covers the fixes. If you are stopping to ask a question or report a blocker, \
say so and end the turn."

log() {
  printf 'eng-hook: %s\n' "$1" >&2
  [ -n "${CLAUDE_PLUGIN_DATA:-}" ] || return 0
  mkdir -p "$CLAUDE_PLUGIN_DATA" 2>/dev/null || return 0
  printf '%s %s error: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$mode" "$1" \
    >> "$CLAUDE_PLUGIN_DATA/eng-hook.log" 2>/dev/null
  # Once the log passes 2000 lines it is cut to its last 1000, so a fault that
  # repeats cannot fill the disk. The copy is named for this process, so two
  # hooks cutting at once do not write the same file.
  if [ "$( (wc -l < "$CLAUDE_PLUGIN_DATA/eng-hook.log") 2>/dev/null || echo 0)" -gt 2000 ]; then
    tail -n 1000 "$CLAUDE_PLUGIN_DATA/eng-hook.log" > "$CLAUDE_PLUGIN_DATA/eng-hook.log.$$" 2>/dev/null &&
      mv "$CLAUDE_PLUGIN_DATA/eng-hook.log.$$" "$CLAUDE_PLUGIN_DATA/eng-hook.log" 2>/dev/null
    rm -f "$CLAUDE_PLUGIN_DATA/eng-hook.log.$$"
  fi
  return 0
}

# Prints one value from the hook's input, or nothing when it is absent.
get() {
  printf '%s' "$input" | jq -r "$1 // empty" 2>/dev/null
}

# Prints the JSON that adds $2 as context on the event named $1.
context() {
  jq -n --arg e "$1" --arg c "$2" \
    '{hookSpecificOutput: {hookEventName: $e, additionalContext: $c}}'
}

# Prints the JSON for a PreToolUse decision, $1, with the reason $2.
decision() {
  jq -n --arg d "$1" --arg r "$2" '{hookSpecificOutput: {
    hookEventName: "PreToolUse", permissionDecision: $d, permissionDecisionReason: $r
  }}'
}

# Prints this session's state directory without creating it. Fails when there
# is no data directory or no session id.
state_path() {
  [ -n "${CLAUDE_PLUGIN_DATA:-}" ] || return 1
  sid="$(printf '%s' "$f_sid" | tr -c 'A-Za-z0-9_-' '-')"
  [ -n "$sid" ] || return 1
  printf '%s\n' "$CLAUDE_PLUGIN_DATA/sessions/$sid"
}

# Sets $state to this session's state directory, creating it. Fails when
# there is no data directory or no session id.
find_state() {
  [ -z "$state" ] || return 0
  state="$(state_path)" || { state=""; return 1; }
  if ! mkdir -p "$state" 2>/dev/null; then
    log "cannot create $state"
    state=""
    return 1
  fi
  # Session start prunes directories by age, so a session in use stays young.
  touch "$state" 2>/dev/null
  return 0
}

# A skill's name as the gate compares it: eng:commit, /eng:commit and commit
# are all commit.
skill_name() {
  n="${1#/}"
  printf '%s' "${n#eng:}"
}

record_skill() {
  [ -n "$1" ] || return 0
  find_state || return 0
  # One write per name, so two skills loading at once cannot run together.
  printf '%s\n' "$(skill_name "$1")" >> "$state/skills"
}

# True when the words in $1 hold one matching the extended regex $2.
has_word() {
  printf ' %s ' "$1" | tr '\t\n' '  ' | grep -Eiq "[[:space:]]($2)[[:space:]]"
}

# Prints a hash of the uncommitted changes in the repo holding directory $1,
# tracked and untracked, leaving out .claude/plans and .claude/handoffs. Prints "clean" when there
# are none, and fails outside a git repo.
tree_state() {
  top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [ -n "$top" ] || return 1
  base=HEAD
  # A repo with no commit yet compares against the empty tree.
  git -C "$top" rev-parse -q --verify HEAD >/dev/null 2>&1 ||
    base=4b825dc642cb6eb9a060e54bf8d69288fbee4904
  # Plans and handoffs are left out, as the review loop's snapshot leaves them.
  # The untracked names are listed once, NUL-separated, so a quote or a
  # newline in one cannot break the list.
  ts_list="$(mktemp "${TMPDIR:-/tmp}/eng-hook-untracked.XXXXXX")" || return 1
  git -C "$top" ls-files -z --others --exclude-standard -- . \
    ':(exclude).claude/plans' ':(exclude).claude/handoffs' > "$ts_list" 2>/dev/null
  if git -C "$top" diff --quiet "$base" -- . ':(exclude).claude/plans' ':(exclude).claude/handoffs' 2>/dev/null &&
    [ ! -s "$ts_list" ]; then
    rm -f "$ts_list"
    printf 'clean\n'
    return 0
  fi
  # The diff streams into the hash rather than sitting in a variable. The
  # untracked files are hashed a hundred at a time; a batch that fails is
  # dropped and hashed file by file, so one that cannot be, such as a link to
  # a directory, stands as its name and only its batch is slowed. The script is single-quoted
  # for sh -c, which expands its arguments.
  # shellcheck disable=SC2016
  ts_hash="$(
    {
      git -C "$top" diff --binary "$base" -- . ':(exclude).claude/plans' ':(exclude).claude/handoffs' 2>/dev/null
      tr '\0' '\n' < "$ts_list"
      [ -s "$ts_list" ] && (cd "$top" && xargs -0 -n 100 sh -c '
        out="$(git hash-object -- "$@" 2>/dev/null)" && { printf "%s\n" "$out"; exit 0; }
        for f; do git hash-object -- "$f" 2>/dev/null || printf "unhashed %s\n" "$f"; done
      ' sh < "$ts_list")
    } | git -C "$top" hash-object --stdin
  )"
  rm -f "$ts_list"
  [ -n "$ts_hash" ] || return 1
  printf '%s\n' "$ts_hash"
}

# Prints the tree object of the working tree as the review loop snapshots it:
# every file, untracked too, with the plans and handoffs as HEAD has them.
worktree_tree() {
  wt_index="$(mktemp "${TMPDIR:-/tmp}/eng-hook-index.XXXXXX")" || return 1
  # Built from HEAD rather than a copy of the index, whose cached file stats
  # can hide an edit made in the same second as the copy.
  rm -f "$wt_index"
  # A step that fails leaves a partial index, whose tree is not this one.
  if GIT_INDEX_FILE="$wt_index" git -C "$1" read-tree HEAD 2>/dev/null &&
    GIT_INDEX_FILE="$wt_index" git -C "$1" add -A 2>/dev/null &&
    GIT_INDEX_FILE="$wt_index" git -C "$1" reset -q -- ':/.claude/plans' ':/.claude/handoffs' 2>/dev/null; then
    GIT_INDEX_FILE="$wt_index" git -C "$1" write-tree 2>/dev/null
    wt_status=$?
  else
    wt_status=1
  fi
  rm -f "$wt_index"
  return "$wt_status"
}

# Prints each remote's default branch in the repo at $1, one ref per line.
# Where a remote names no default, its main and master stand in.
default_refs() {
  for remote in $(git -C "$1" remote 2>/dev/null); do
    default="$(git -C "$1" symbolic-ref -q "refs/remotes/$remote/HEAD" 2>/dev/null)"
    if [ -n "$default" ]; then
      printf '%s\n' "$default"
    else
      printf '%s\n' "refs/remotes/$remote/main" "refs/remotes/$remote/master"
    fi
  done
}

# Succeeds when the range $2..$3 in the repo at $1 starts at or before where
# $3 left some remote's default branch, so it reads the whole pull request
# rather than its last few commits.
whole_range() {
  range_first="$(git -C "$1" rev-parse -q --verify "$2^{commit}" 2>/dev/null)" || return 1
  for default in $(default_refs "$1"); do
    range_base="$(git -C "$1" merge-base "$default" "$3" 2>/dev/null)" || continue
    git -C "$1" merge-base --is-ancestor "$range_first" "$range_base" 2>/dev/null && return 0
  done
  return 1
}

# Records that the commit $1 was reviewed as the pull request, when it is the
# one the last push or new pull request left on a remote branch.
mark_pr_reviewed() {
  [ -n "$1" ] || return 0
  [ "$1" = "$(cat "$state/pr-head" 2>/dev/null)" ] || return 0
  printf '%s\n' "$1" > "$state/pr-review"
}

# Records that the uncommitted changes were reviewed, when the review's
# arguments, $1, cover them: no target, which reviews the local changes, or a
# range ending in a snapshot of this very tree. A pull request or another
# range reviews something else, so neither counts for the local changes.
#
# It also records the review of the whole pull request, at high or above: a
# pull request by number or link to the pull request itself, or a range
# ending at the pushed commit whose ends meet at or before the merge base with
# a remote's default branch, which stands in for the PR's base. The end of the
# last such range is kept as reviewed-commit, so a review run just before a
# push counts once the push lands on that same commit. A review loop's
# snapshot is never the commit that lands, so it does not count.
#
# A range at high or above whose end is this very tree, and whose start's
# tree differs, is kept as reviewed-tree, which a push under a plan's grant
# has to match.
record_review() {
  find_state || return 0
  cwd="$f_cwd"
  start="" target="" local=yes deep=no
  skip=no
  pr=no
  # The arguments are words to read, not patterns to expand against files.
  set -f
  for a in $1; do
    if [ "$skip" = yes ]; then skip=no; continue; fi
    case "$a" in
      [hH][iI][gG][hH] | [xX][hH][iI][gG][hH] | [mM][aA][xX] | [uU][lL][tT][rR][aA]) deep=yes ;;
      [lL][oO][wW] | [mM][eE][dD][iI][uU][mM]) ;;
      --max-findings) skip=yes ;;
      -*) ;;
      # A link to a range inside a pull request reads part of it.
      http*..*) set +f; return 0 ;;
      # A range with no end, such as origin/main.., stops at HEAD and so reads
      # no uncommitted change.
      *..) start="${a%..}" start="${start%.}" target=HEAD local=no ;;
      *..*) start="${a%%..*}" target="${a##*..}" ;;
      # A pull request reads what was pushed to it, not the local changes. A
      # link to one of its commits reads part of it.
      http*/pull/[0-9]* | http*/merge_requests/[0-9]*)
        rest="${a#*/pull/}"
        [ "$rest" = "$a" ] && rest="${a#*/merge_requests/}"
        # A query or an anchor can narrow the page to one commit or thread,
        # so a link with either does not count.
        case "${rest#"${rest%%[!0-9]*}"}" in
          '' | / | /files | /files/ | /changes | /changes/ | /diffs | /diffs/) pr=yes ;;
          *) set +f; return 0 ;;
        esac ;;
      '#'[0-9]*)
        case "${a#?}" in *[!0-9]*) set +f; return 0 ;; esac
        pr=yes ;;
      # A branch, a commit or another URL is not the local changes.
      *[!0-9]*) set +f; return 0 ;;
      # Digits alone are a pull request's number.
      *) pr=yes ;;
    esac
  done
  set +f
  # The whole pull request asks for a review at high or above.
  if [ "$pr" = yes ]; then
    [ "$deep" = yes ] || return 0
    mark_pr_reviewed "$(cat "$state/pr-head" 2>/dev/null)"
    return 0
  fi
  if [ -n "$target" ]; then
    top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" || return 0
    end="$(git -C "$top" rev-parse -q --verify "$target^{commit}" 2>/dev/null)"
    # The range covers every commit after the point where its two ends meet,
    # whether written with two dots or three.
    [ -n "$end" ] && start="$(git -C "$top" merge-base "$start" "$end" 2>/dev/null)"
    if [ -n "$end" ] && [ "$deep" = yes ] && whole_range "$top" "$start" "$end"; then
      printf '%s\n' "$end" > "$state/reviewed-commit"
      mark_pr_reviewed "$end"
    fi
    [ "$local" = yes ] || return 0
    reviewed="$(git -C "$top" rev-parse -q --verify "$target^{tree}" 2>/dev/null)" || return 0
    [ "$reviewed" = "$(worktree_tree "$top")" ] || return 0
    # A plan's grant pushes only this tree, once it is committed, and only
    # after a review at high or above, as the review loop runs, of a range
    # that changes something.
    start_tree="$(git -C "$top" rev-parse -q --verify "$start^{tree}" 2>/dev/null)"
    [ "$deep" = yes ] && [ -n "$start_tree" ] && [ "$start_tree" != "$reviewed" ] &&
      printf '%s\n' "$reviewed" > "$state/reviewed-tree"
  fi
  now="$(tree_state "$cwd")" || return 0
  printf '%s\n' "$now" > "$state/review-hash"
}

session_start() {
  contract="$root/standards/workflow.md"
  writing="$root/skills/plain-writing/SKILL.md"

  if [ ! -r "$contract" ]; then
    log "cannot read $contract, so no contract was sent"
    return 0
  fi

  text="$(cat "$contract")"

  if [ -r "$writing" ]; then
    # The Punctuation and Word choice sections, each from its heading to the
    # next one. Any section between or after them stays out.
    rules="$(awk '
      /^## / { keep = ($0 == "## Punctuation" || $0 == "## Word choice") }
      keep
    ' "$writing")"
    if [ -n "$rules" ]; then
      text="$text

The writing rules every reply follows, from the eng:plain-writing skill:

$rules"
    else
      log "found no Punctuation or Word choice section in $writing"
    fi
  else
    log "cannot read $writing, so the writing rules were not sent"
  fi

  if ! command -v jq >/dev/null 2>&1; then
    log "jq not found, so the block went out as plain text and the skill listing was not reloaded"
    printf '%s\n' "$text"
    return 0
  fi

  source="$(get .source)"
  reload=false
  [ "$source" = compact ] && reload=true

  jq -n --arg ctx "$text" --argjson reload "$reload" '{
    hookSpecificOutput: (
      {hookEventName: "SessionStart", additionalContext: $ctx}
      + (if $reload then {reloadSkills: true} else {} end)
    )
  }' || log "jq could not build the output"

  if find_state; then
    # A resume or a compaction keeps the changes the session started with.
    # Hashing a large tree here could cost the block its timeout, so the first
    # prompt hashes it instead, before the model can change anything.
    if [ "$source" = startup ] || [ "$source" = clear ] || [ ! -f "$state/start-hash" ]; then
      rm -f "$state/start-hash"
      : > "$state/start-pending"
    fi
    # A plan file counts as waiting only when changed after this mark. A
    # clear starts a new conversation, which ends any grant; a resume or a
    # compaction keeps it.
    if [ "$source" = startup ] || [ "$source" = clear ] || [ ! -f "$state/started" ]; then
      : > "$state/started"
    fi
    [ "$source" = clear ] && rm -f "$state/grant" "$state/grant-pushes"
    find "$CLAUDE_PLUGIN_DATA/sessions" -mindepth 1 -maxdepth 1 -type d -mtime +30 \
      -exec rm -rf {} + 2>/dev/null
    # The slash follows /tmp where it is a link, as on macOS.
    find "${TMPDIR:-/tmp}/" -maxdepth 1 -type f -name 'eng-hook-*' -mtime +0 \
      -exec rm -f {} + 2>/dev/null
  fi
  return 0
}

# The part of a prompt that is your own words. In a Claude project a message
# arrives wrapped with the project's routing, and a relay from the project's
# coordinator quotes yours, so only the bodies a human wrote count there.
request_text() {
  printf '%s' "$1" | jq -Rrs '
    if test("^\\s*<(wake|relay|project_claude_message)[ >]") or contains("<coordinator-relay>") then
      [ scan("<message[^>]*from=\"human\"[^>]*>([\\s\\S]*?)</message>"),
        scan("<cited[^>]*author=\"user\"[^>]*>([\\s\\S]*?)</cited>") ]
      | map(.[0]) | join("\n")
    else . end' 2>/dev/null
}

# Your message is kept before the first prompt's tree is hashed, because the
# hash can take long enough in a large repo for the hook to run out of time,
# and the gate would then read the message before it.
on_prompt() {
  on_message
  if find_state && [ -f "$state/start-pending" ]; then
    tree_state "$f_cwd" > "$state/start-hash" 2>/dev/null || rm -f "$state/start-hash"
    rm -f "$state/start-pending"
  fi
}

on_message() {
  note=""
  text="$(get .prompt)"
  lead="$(printf '%s\n' "$text" | sed -n '/[^[:space:]]/{s/^[[:space:]]*//;p;q;}')"
  # A background task or a subagent reporting back, a CI event, or another
  # session's message is not yours, so it keeps the state of the message
  # before it.
  case "$lead" in
    '<task-notification'* | '<cross-session-message'* | '<agent-message'* | '<ci-monitor-event'*) return 0 ;;
  esac
  request="$(request_text "$text")"
  # A project event no human wrote, such as CI reporting back, keeps it too.
  case "$lead" in
    '<wake '* | '<wake>'* | '<relay '* | '<relay>'* | '<project_claude_message'*) envelope=yes ;;
    *) case "$text" in *'<coordinator-relay>'*) envelope=yes ;; *) envelope=no ;; esac ;;
  esac
  if [ "$envelope" = yes ] && [ -z "$(printf '%s' "$request" | tr -d '[:space:]')" ]; then
    return 0
  fi
  if find_state; then
    printf '%s\n' "$request" > "$state/turn"
    : > "$state/skills"
    check_grant "$request"
    # UserPromptExpansion fires before this, so a skill typed as a slash
    # command is recorded again after the reset.
    case "$lead" in
      /*) record_skill "${lead%%[[:space:]]*}" ;;
    esac
  fi

  pr='https?://github\.com/[^/[:space:]]+/[^/[:space:]]+/pull/[0-9]+'
  hint=""
  if printf '%s' "$request" | grep -Eq "${pr}[^[:space:]]*#(issuecomment-|discussion_r|pullrequestreview-|r[0-9])"; then
    hint="The message links a pull request review comment. The eng:pr-feedback skill covers review feedback."
  elif printf '%s' "$request" | grep -Eq "$pr" &&
    [ -z "$(printf '%s' "$request" | sed -E "s#${pr}[^[:space:]]*##g" | tr -d '[:space:]')" ]; then
    hint="The message is a pull request link with no request. Ask what to do with it rather than starting a review."
  fi
  # What the grant check found goes out beside any hint, never instead of it.
  hint="$hint${hint:+${note:+ }}$note"
  [ -z "$hint" ] || context UserPromptSubmit "$hint"
}

on_expansion() {
  name="$(skill_name "$(get .command_name)")"
  case "${name##*:}" in
    code-review | review)
      if has_word "$(get .command_args)" "$POST_FLAGS"; then
        jq -n --arg r "The eng plugin blocks --comment and --post on a review, because nothing is posted to a pull request from here. Run it without them and the findings stay in the session; ask for a draft file of comments if you want one." \
          '{decision: "block", reason: $r}'
        return 0
      fi
      record_review "$(get .command_args)"
      ;;
  esac
  record_skill "$name"
}

# Sets $verdict to allow or deny, and $reason, for a write the eng skill named
# by $1 runs: commit, push, pr or issue. The write runs unless the user's
# latest message says not to.
gate() {
  verdict=allow
  reason=""
  case "$1" in
    commit)
      skills=commit label=commit via="the eng:commit skill"
      words="$COMMIT_WORDS" ;;
    push)
      skills="commit pr" label=push via="the eng:commit skill, or eng:pr when it pushes its branch"
      words="$PUSH_WORDS" ;;
    pr)
      skills=pr label="pull request change" via="the eng:pr skill"
      words="$PR_WORDS" ;;
    *)
      skills=issue label="issue change" via="the eng:issue skill"
      words="$ISSUE_WORDS" ;;
  esac
  if [ -n "$f_agent" ]; then
    verdict=deny
    reason="A subagent never commits, pushes, changes a pull request or writes an issue. Hand the work back to the main session."
    return 0
  fi
  # With no state to read, the gate fails open, like every check but the
  # command parser.
  find_state && [ -f "$state/turn" ] || return 0
  loaded=no
  for s in $skills; do
    grep -qx "$s" "$state/skills" 2>/dev/null && loaded=yes
  done
  if [ "$loaded" = no ]; then
    verdict=deny
    reason="Load $via with the Skill tool first. It runs this $label, and checks that the user's latest message wants one."
    return 0
  fi
  said_no "$words"
  case $? in
    0)
      verdict=deny
      reason="The user's latest message says not to do this $label. Do not run it. Say why you stopped, and go on with the rest." ;;
    1) ;;
    *) log "the check of the latest message for a no failed" ;;
  esac
}

# True when the user's latest message says not to do a write named by the
# extended regex $1. The hook only catches a plain no, and leaves anything
# subtler to the skills, which read meaning rather than words.
#
# A no is a negation right before the write, with nothing between them but
# small words or a list of writes, and nothing after it but the end of the
# clause or a word such as "it", "yet" or "until": "don't push", "no PR",
# "don't stage, commit or push", "commit without pushing", "hold the push",
# "never mind the push", "I'll push it myself", "don't push yet, okay?". A
# deferral right after the write counts too: "push it later", "push once I
# approve". So "don't commit the .env file" and "don't push to
# main" narrow the write rather than refuse it.
#
# A report is not a no: "it didn't push", "I can't commit", "it won't push",
# "if you can't push" and a past form such as "not pushed" state a fact, and
# "no, you push it" answers rather than refuses.
#
# The places the message names the write are read from the last one back. One
# inside a no refuses the write. One that opens a request asks for it: after a
# stop, a comma, a dash, "please", "can you", "then" or the like,
# perhaps followed by "you" or a verb such as "open a new" or "retry the", or
# after "you should" outside a condition. In a sentence after the no, a mention
# right after a word that asks, such as "go", "let's", "actually", "time to"
# or "open the", asks too, unless it only names the write ("when to push", "Sam will
# open the PR"). So "I didn't push it, can you push", "don't push. Actually,
# push it" and "don't push yet. OK, go push" ask for the push, while "Don't
# open a PR. The PR template is broken" does not. Any other mention passes to
# the one before it. A plain list joined by "and" after a negation that tells,
# as in "don't commit and push", refuses every write in it.
#
# A question drops out: the whole sentence when it opens with a question word,
# so "why don't you push, then?" refuses nothing, and otherwise back to its
# last comma, so "don't push, why did CI fail?" still refuses. "There's no PR
# yet" states a fact. A takeback, a wait or a condition, such as "actually,
# just commit", "commit and push. Not yet" or "let me review first", is left
# to the skills.
said_no() {
  target="($1)"
  text="$(tr '[:upper:]' '[:lower:]' < "$state/turn" | tr '\n\t' '  ' |
    sed -E "s/(don[^a-z ]{0,3}t|do not|never) (forget( about)?|stop) (to |the |a |an )?/\\4/g; s/whether or not /whether /g" |
    awk '{ n = split($0, part, /[?]/); out = ""
      for (i = 1; i <= n; i++) {
        s = part[i]
        if (i < n) {
          k = 0; for (j = length(s); j > 0; j--) if (substr(s, j, 1) ~ /[.!;]/) { k = j; break }
          q = substr(s, k + 1); sub(/^ +/, "", q)
          if (q !~ /^(why|what|how|where|when|who|which|can|could|would|will|should|shall|is|are|was|were|does|did|any)([^a-z]|$)/)
            for (j = length(s); j > k; j--) if (substr(s, j, 1) == ",") { k = j; break }
          s = substr(s, 1, k)
        }
        out = out s " " }
      print out }' |
    sed -E "s/(there[^a-z ]{0,3}s|there is|there are|there was|we have|we[^a-z ]{0,3}ve got|i have) no (((a|an|the) )?($WRITE_WORDS)[^a-z0-9_-])/\\1 zero \\2/g; s/(^|[^a-z])no,? (you|i|we|it|that|this) /\\1nope \\2 /g; s/(^|[^a-z])(it|that|this|ci|git|the hook|the branch)( won[^a-z ]{0,3}t| wont| did not| does not| will not| is not|[^a-z ]{1,3}s not)( even| really| actually)? +(($WRITE_WORDS)[^a-z0-9_-])/\\1\\2 failed to \\5/g; s/(^|[^a-z])if you (can[^a-z ]{0,3}t|cannot|can not) /\\1if you fail to /g; s/(^|[^a-z])no ((a |an |the )?($WRITE_WORDS)( yet)?( for [a-z]+)?[ ,;.:!-]+(ok,? |so |please |just |now |go |then |let.?s |go ahead and )?(open|make|file|create|raise) (one|it|a new))/\\1zero \\2/g; s/(^|[^a-z])why (don[^a-z ]{0,3}t you|not) /\\1/g")"
  q='[^a-z ]?[^a-z ]?[^a-z ]?'
  # Only a negation that tells: "didn't", "wasn't" or "I can't" report a fact,
  # as in "it didn't push, push again", while "you can't push" tells. A report
  # about the tool, such as "it won't push" or "it's not pushing", was turned
  # into "it failed to push" above.
  neg="(you (can${q}t|cannot|can not|may not|must not)|don${q}t|won${q}t|shouldn${q}t|mustn${q}t|needn${q}t|dont|wont|shouldnt|mustnt|neednt|do not|never|not|no|no need (to|for)|without|refrain from|avoid|wait (before|on|with))"
  # The negations that also refuse a list joined by "and", as in "don't commit
  # and push". "No" and "without" do not, so "no PR and push it" asks for the
  # push.
  tell="(you (can${q}t|cannot|can not|may not|must not)|don${q}t|won${q}t|shouldn${q}t|mustn${q}t|needn${q}t|dont|wont|shouldnt|mustnt|neednt|do not|never|avoid|refrain from)"
  # Words that drop the write, or keep it for yourself, reach it only across
  # small words, so "I'll leave it to you to push" asks for the push.
  drop="(i${q}ll|i will|hold( off)?( on)?|leave|never ?mind( about)?|forget( about)?|scratch|scrap|cancel|drop|skip|stop|quit) +((the|a|an|my|your|our|any|this|that|these|those|it|do|handle|open|create|file|make|raise|submit|update|edit|close|reopen) +)*"
  # A list of writes is refused as a whole when it ends in "or" or "nor", as
  # in "don't stage, commit or push", or, after one of the $tell negations,
  # when it is joined by "and", as in "don't commit and push". So "skip the PR
  # and push" or "no PR, push it" still asks for the push.
  list="(($WRITE_WORDS), +)*($WRITE_WORDS),? (or|nor) +"
  gap="(((the|a|an|any|my|your|our|this|that|these|those|it|ever|again|even|or|nor|to|want|you|open|create|raise|make|submit|update|edit|close|reopen|file|touch|run|use|git|gh|glab|handle|do|need|you dare|ready to) +)|$list)*"
  end="( *[^a-z0-9_ -]| *$| +-+ | +(it|this|that|them|yet|now|anything|anymore|either|again|until|unless|before|under|for|at all|or|and|nor|please|myself|yourself|till|today|alone|to me|needed|necessary|(the|your|my|our|any|these|those) (changes?|work|code|branch|prs?|commits?))[^a-z0-9_-])"
  later="(,? +(it|this|that|them))?,? +(later|tomorrow|not yet|not now|once i|after i|until i|till i|when i say)[^a-z]"
  # A long dash also opens a request. It is written as bytes, since the repo
  # holds no dash characters.
  long="$(printf '\342\200\224')"
  # An opener, then perhaps a verb that asks, as in ", open a new PR" or
  # ". You push it". A verb with no opener, as in "Sam will open the PR", asks
  # for nothing.
  opener="(^ *|[.;:!,] *|[^a-z]-+ *|$long *|[^a-z](please|can you|could you|go ahead and|now|then|so|just|and|you can|feel free to|need you to|want you to) +)"
  cue="$opener((you|retry|redo|try|open|create|make|raise|file|edit|update|recommit|re-?push) +((a|an|the|new|this|that|it|to|existing|old|current|same) +)*)?\$"
  printf ' %s \n' "$text" | awk -v target="$target" \
    -v r1="[^a-z]($neg +$gap|$drop)$target$end" -v r2="[^a-z0-9_-]$target$later" \
    -v r3="[^a-z]($neg +$gap|$drop)$list($WRITE_WORDS)$end" \
    -v r4="[^a-z]$tell +(($WRITE_WORDS) +(and|or|nor) +)+($WRITE_WORDS)$end" -v cue="$cue" '
    function spans(s, r,   pos, m) {
      pos = 1
      while (pos <= length(s) && match(substr(s, pos), r)) {
        m = pos + RSTART - 1; n++; from[n] = m; to[n] = m + RLENGTH - 1; pos = m + 1 }
    }
    {
      s = $0; n = 0; k = 0
      # r3 and r4 cover every write in a refused list, the first ones too:
      # "do not stage, commit or push", "do not commit and push".
      spans(s, r1); spans(s, r2); spans(s, r3); spans(s, r4)
      pos = 1; w = "[^a-z0-9_-]" target "[^a-z0-9_-]"
      while (pos <= length(s) && match(substr(s, pos), w)) { k++; at[k] = pos + RSTART; pos = at[k] }
      for (j = k; j > 0; j--) {
        # A past form, such as "pushed", reports rather than asks or refuses.
        if (substr(s, at[j], 40) ~ /^[a-z-]*ed[^a-z]/) continue
        for (i = 1; i <= n; i++) if (at[j] > from[i] && at[j] <= to[i]) exit 0
        # A mention that opens a request asks for the write, and so does one
        # right after a word that asks in a later sentence than a no, unless
        # it only names the write, as in "when to push" or "Sam will open the
        # PR".
        head = substr(s, 1, at[j] - 1)
        if (head ~ cue) exit 1
        if (head ~ /[^a-z]you +(should|could|can|may|might|will|would|need to|have to|must) +$/ &&
          head !~ /(until|till|when|unless|before|after|once|if) [^.;!,]*$/) exit 1
        if (head ~ /[^a-z](go|let.?s|time to|ok|okay|do|go ahead and|actually|jk|we can|you can|thought|i want you to|now|open|create|make|raise|file|update|edit|submit|retry|redo)( +(a|an|the|new|this|that|it))* +$/ &&
          head !~ /(when|whether|how|where|what) +to +([a-z]+ +)?((the|a|an|this|that|new) +)*$/ &&
          head !~ /(will|would|[^a-z ]ll|could|should|might|may) +([a-z]+ +)?((the|a|an|this|that|new) +)*$/) {
          # Only in a sentence after the no.
          for (i = 1; i <= n; i++) if (to[i] < at[j] && substr(s, to[i], at[j] - to[i]) ~ /[.;!]/) exit 1
        }
      }
      exit 1
    }'
}

# The words that make an approval conditional, deferred, a request for
# changes or a no. A message holding any of them, a contraction ending in
# "n't", or a question mark grants nothing.
NOT_APPROVAL="not no never cannot dont didnt doesnt cant wont isnt havent hasnt wouldnt \
shouldnt couldnt arent wasnt werent before but once \
when wait except after until unless if later yet hold without maybe \
stop though first withdraw revoke retract"

# The words that, beside "approve" in a later message, take an approval
# back, read as an extended regex over the message's words.
NEGATION=' (not|no|never|cannot|nope|dont|didnt|doesnt|cant|wont|isnt|arent|wasnt|werent|havent|hasnt|hadnt|wouldnt|shouldnt|couldnt|mustnt) | (withdr|revok|retract)| (took|take|taking) [a-z ]*back '

# Prints the plan files in .claude/plans of the checkout at $1, one path per
# line. With "waiting" as $2, only those changed since the session started
# whose first five lines hold "Status: awaiting approval". The date keeps an
# old plan from counting. Another checkout's plans, such as the main clone's
# beside a worktree, belong to other sessions and are left out.
plan_files() {
  g_top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || return 0
  [ -d "$g_top/.claude/plans" ] || return 0
  if [ "${2:-}" = waiting ]; then
    [ -f "$state/started" ] || return 0
    find "$g_top/.claude/plans" -maxdepth 1 -type f -name '*.md' -newer "$state/started" 2>/dev/null |
      sort | while IFS= read -r g_file; do
        head -n 5 "$g_file" | tr -d '\r' | grep -qx 'Status: awaiting approval' && printf '%s\n' "$g_file"
      done
  else
    find "$g_top/.claude/plans" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort
  fi
}

# Prints the value of the line "$2: value", at the start of a line, in the
# plan file $1, backticks dropped.
plan_field() {
  sed -n "s/^$2:[[:space:]]*//p" "$1" 2>/dev/null | head -n 1 | tr -d '`\r' | sed 's/[[:space:]]*$//'
}

# Appends one line to the log of writes made under a grant, which the stats
# script is to count (it does not read it yet):
# the time, the session, the plan, its branch, the kind of write, $1, and its
# commit, $2.
log_write() {
  printf '%s %s %s %s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$f_sid" \
    "$(sed -n 2p "$state/grant")" "$(sed -n 1p "$state/grant")" "$1" "$2" \
    >> "$CLAUDE_PLUGIN_DATA/grant-writes.log" 2>/dev/null
}

# True when your latest message says not to commit, push or change a pull
# request, each read on its own as the gate reads it, so "skip the push, just
# commit" is a no to the push.
no_to_a_write() {
  for g_w in "$COMMIT_WORDS" "$PUSH_WORDS" "$PR_WORDS"; do
    said_no "$g_w" && return 0
  done
  return 1
}

# Prints a sentence saying a grant recorded earlier still holds, when one
# does, for a note that grants nothing new.
grant_still() {
  [ -f "$state/grant" ] || return 0
  printf ' The grant for plan %s, recorded earlier, still holds.' "$(sed -n 2p "$state/grant")"
}

# Reads your message, $1, for an approval of a plan waiting in this session,
# and records the grant: the plan's branch, name and file, the commit it
# started from, and the time, one per line. A message of yours saying
# "approve" or "approved", with no condition, grants the one plan waiting,
# or, when several are, the one it names, as long as what it approves is
# the plan rather than something else. A no to a commit, push or pull
# request ends a grant, and so does a later message that speaks of approving
# along with a negation or a take-back word, such as "I don't approve" or "I
# revoked my approval", or whose first line opens with "hold" or "wait".
# $note says what happened, for the model to read.
check_grant() {
  g_no=""
  if [ -f "$state/grant" ]; then
    g_no=no
    if no_to_a_write; then
      rm -f "$state/grant" "$state/grant-pushes"
      note="Your message says not to commit, push or open the pull request, so the approved plan's grant has ended. Each of those needs its own ask again."
      return 0
    fi
  fi
  g_text="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' |
    sed "s/$(printf '\342\200\231')/'/g; s/$(printf '\342\200\230')/'/g; s/$(printf '\312\274')/'/g; s/\`/'/g;
      s/$(printf '\342\200\224')/;/g; s/$(printf '\342\200\223')/;/g; s/ - /; /g")"
  g_words=" $(printf '%s' "$g_text" | tr -c 'a-z0-9_-' ' ' | tr -s ' ') "
  # Once a plan is approved, doubt about the approval ends the grant: a first
  # line that opens with "hold" or "wait", or a message that speaks of
  # approving along with a negation or a take-back word, as in
  # "I don't approve" or "I revoked my approval". Reading a passing mention
  # this way only costs an ask before the next write.
  if [ -f "$state/grant" ]; then
    g_back=""
    printf '%s\n' "$g_text" | sed -n '/[^[:space:]]/{p;q;}' | grep -Eq '^[[:space:]]*(hold|wait)([^a-z]|$)' &&
      g_back=yes
    case "$g_words" in
      *' disapprov'*) g_back=yes ;;
      *' approv'*)
        case "$g_text" in *"n't"*) g_back=yes ;; esac
        printf '%s' "$g_words" | sed 's/n t /nt /g' | grep -Eq "$NEGATION" && g_back=yes ;;
    esac
    if [ -n "$g_back" ]; then
      rm -f "$state/grant" "$state/grant-pushes"
      note="Your message speaks of the approval with doubt, so the approved plan's grant has ended. Each commit, push and pull request needs its own ask again. If the user still wants the plan delivered, they can approve it again once its status is set back to awaiting approval."
      return 0
    fi
  fi
  case "$g_words" in *' approve '* | *' approved '*) ;; *) return 0 ;; esac
  g_why=""
  case "$g_text" in *'?'*) g_why="it asks a question" ;; esac
  case "$g_text" in *"n't"*) g_why="it holds a negation" ;; esac
  for g_w in $NOT_APPROVAL; do
    case "$g_words" in *" $g_w "*) g_why="it says \"$g_w\"" ;; esac
  done
  # A change, changes, an edit, edits or a tweak mean the plan is not settled,
  # unless the run is to finish them, as in "finalize the changes" or "commit
  # the edits", with the phrase, or the phrase and "and the PR", ending its
  # clause. Punctuation ends a clause.
  case "$(printf '%s' "$g_text" | tr '.,;:!?\n' '||||||' | tr -c 'a-z0-9_|-' ' ' | sed 's/|/ | /g' | tr -s ' ' |
    sed -E -e 's/^/ /' -e 's/$/ /' -e ':a' \
      -e 's/ (finali[sz]e|commit|push|ship|merge|land) ((the|these|this|all|my|your|our) ){0,2}(change|changes|edit|edits|tweak|tweaks)( and (the )?(pr|pull request))?( \| |[[:space:]]*$)/ \8/' -e 'ta')" in
    *' change '* | *' changes '* | *' edit '* | *' edits '* | *' tweak'*) g_why="it asks for changes" ;;
  esac
  [ -n "$g_why" ] || [ -n "$g_no" ] || ! no_to_a_write || g_why="it says not to commit, push or open the pull request"
  g_plans="$(plan_files "$f_cwd" waiting)"
  if [ -n "$g_why" ]; then
    if [ -f "$state/grant" ]; then
      note="Your message grants nothing new, because $g_why.$(grant_still)"
    elif [ -n "$g_plans" ]; then
      note="Your message reads as an approval with a condition, a change or a no, because $g_why, so no plan is granted its writes. Keep working on the plan with the user."
    fi
    return 0
  fi
  if [ -z "$g_plans" ]; then
    if [ -f "$state/grant" ]; then
      note="No other plan is waiting for approval, so nothing new is granted.$(grant_still)"
    elif [ -n "$(plan_files "$f_cwd")" ] || case "$g_words" in *' plan '*) true ;; *) false ;; esac; then
      note="Your message approves, but no plan file in .claude/plans is waiting for approval in this session, so no writes are granted. Each still needs its own ask."
    fi
    return 0
  fi
  # What is approved has to be the plan. After the first "approve" or
  # "approved", up to the end of its clause or "and", comes nothing, "it",
  # "this", "that", "the plan", or a waiting plan's name, perhaps as "the
  # <name> plan", with "of" before any of them, or "all", "entirely",
  # "fully", "in full" or "as written" after. So "approve the dependabot PR"
  # is not about the plan, and neither is a later "Sam approved it".
  g_waiting_names="$(printf '%s\n' "$g_plans" | while IFS= read -r g_file; do
    [ -n "$g_file" ] && plan_field "$g_file" 'Plan name' | tr '[:upper:]' '[:lower:]'; done)"
  # The object comes marked with "=", so no line at all means no approval.
  g_object="$(printf '%s' "$g_text" | tr '.,;:!?\n' '||||||' | tr -c 'a-z0-9_|-' ' ' |
    awk -v RS='|' '{ n = split($0, w, " ")
      for (i = 1; i <= n; i++) if (w[i] == "approve" || w[i] == "approved") {
        # A hedge or a question right before it, as in "I would approve it",
        # "I d approve" or "should I approve it", is not an approval.
        if (i > 1 && w[i - 1] ~ /^(would|should|could|might|may|will|ll|d|can|have)$/) { print "?"; exit }
        if (w[1] ~ /^(should|could|would|can|may|shall|do|will)$/) { print "?"; exit }
        o = ""; for (j = i + 1; j <= n && w[j] != "and"; j++) o = o (o == "" ? "" : " ") w[j]
        print "=" o; exit } }')"
  g_about=""
  if [ "$g_object" = '?' ]; then
    note="Your message hedges or asks about approving rather than approving, so no plan is granted its writes. Keep working on the plan with the user.$(grant_still)"
    return 0
  fi
  case "$g_object" in
    '='*)
      g_object="$(printf '%s' "${g_object#=}" | sed -E 's/^of //; s/ (all|entirely|fully|in full|as written)$//;
        s/^(the |this )?plan( |$)//; s/^(the |this )//; s/ plan$//')"
      case "$g_object" in
        '' | it | this | that | plan) g_about=yes ;;
        *) printf '%s\n' "$g_waiting_names" | grep -qxF -- "$g_object" && g_about=yes ;;
      esac ;;
  esac
  if [ -z "$g_about" ]; then
    [ -n "$g_plans" ] &&
      note="Your message approves something other than the plan, so no plan is granted its writes. To approve the plan, the user says so, as in \"I approve it\" or \"approve the plan\".$(grant_still)"
    return 0
  fi
  g_count=0 g_named=0 g_chosen="" g_only="" g_names=""
  while IFS= read -r g_file; do
    [ -n "$g_file" ] || continue
    g_count=$((g_count + 1))
    g_only="$g_file"
    g_name="$(plan_field "$g_file" 'Plan name' | tr '[:upper:]' '[:lower:]')"
    g_names="${g_names:+$g_names, }$g_name"
    [ -n "$g_name" ] || continue
    case "$g_words" in *" $g_name "*) g_named=$((g_named + 1)) g_chosen="$g_file" ;; esac
  done <<EOF
$g_plans
EOF
  if [ "$g_count" -eq 1 ]; then
    g_chosen="$g_only"
  elif [ "$g_named" -ne 1 ]; then
    note="Several plans are waiting for approval ($g_names), and your message does not name exactly one, so no writes are granted. Ask the user which one.$(grant_still)"
    return 0
  fi
  g_name="$(plan_field "$g_chosen" 'Plan name')"
  g_branch="$(plan_field "$g_chosen" Branch)"
  if [ -z "$g_name" ] || [ -z "$g_branch" ]; then
    note="The plan in $g_chosen has no \"Plan name:\" line, or no \"Branch:\" line in its Delivery section, so no writes are granted. Each still needs its own ask.$(grant_still)"
    return 0
  fi
  # A grant never covers a push to a default branch.
  for g_ref in $(default_refs "$f_cwd") refs/remotes/origin/main refs/remotes/origin/master; do
    if [ "${g_ref#refs/remotes/*/}" = "$g_branch" ]; then
      note="The plan $g_name names $g_branch, a default branch, which a grant never covers, so no writes are granted. Each still needs its own ask.$(grant_still)"
      return 0
    fi
  done
  # The plan stops waiting, so a later "approve" cannot grant it again and
  # reset the count of pushes. The grant is written first and removed when
  # the plan cannot be marked, so neither is left without the other.
  if ! printf '%s\n' "$g_branch" "$g_name" "$g_chosen" \
    "$(git -C "$f_cwd" rev-parse -q --verify HEAD 2>/dev/null)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$state/grant" 2>/dev/null; then
    rm -f "$state/grant"
    note="The grant for plan $g_name could not be saved, so no writes are granted. Each still needs its own ask."
    return 0
  fi
  if ! { sed '1,5s/^Status: awaiting approval\r\{0,1\}$/Status: approved/' "$g_chosen" > "$g_chosen.$$" 2>/dev/null &&
    mv "$g_chosen.$$" "$g_chosen" 2>/dev/null; }; then
    rm -f "$g_chosen.$$" "$state/grant"
    note="The plan file $g_chosen could not be marked approved, so no writes are granted. Each still needs its own ask."
    return 0
  fi
  rm -f "$state/grant-pushes"
  log_write grant "$(sed -n 4p "$state/grant")"
  note="Your message approves plan $g_name ($g_chosen). The writes its Delivery section lists may now run on branch $g_branch without another ask, as the deliver reference of the eng:implement skill says. The hook lets a push or a new pull request through without asking only through the Bash tool, on that branch, as a plain git push or gh pr create, of a tree the review loop read, six times."
}

# Succeeds when the shell command in $command is a plain push of the granted
# branch $1: git push with -u, --set-upstream, -q or --quiet, and perhaps
# origin, then $1 or HEAD, with no push refspec, mirror or push URL on
# origin, no URL rewrite, and no setting that pushes tags or submodules too.
# With
# no branch named, push.default has to be a plain one, no push remote may be
# set, and git's push target has to be origin's $1.
plain_push() {
  g_branch="$1"
  case "$command" in *[\;\&\|\<\>\$\`\(\)\{\}\\\"\']* | *'
'*) return 1 ;; esac
  set -f
  # The command is split into words on purpose.
  # shellcheck disable=SC2086
  set -- $command
  set +f
  [ "${1:-}" = git ] && [ "${2:-}" = push ] || return 1
  shift 2
  g_remote="" g_ref=""
  for g_w; do
    case "$g_w" in
      -u | --set-upstream | -q | --quiet) ;;
      -*) return 1 ;;
      *)
        if [ -z "$g_remote" ]; then
          g_remote="$g_w"
        elif [ -z "$g_ref" ]; then
          g_ref="$g_w"
        else
          return 1
        fi ;;
    esac
  done
  [ -z "$g_remote" ] || [ "$g_remote" = origin ] || return 1
  # A push refspec or a mirror setting on origin sends a branch somewhere
  # else, or every branch, whatever the command names.
  [ -z "$(git -C "$f_cwd" config --get-all remote.origin.push 2>/dev/null)" ] || return 1
  [ "$(git -C "$f_cwd" config --bool remote.origin.mirror 2>/dev/null)" != true ] || return 1
  # Settings that send tags or submodules along with the branch.
  [ "$(git -C "$f_cwd" config --bool push.followTags 2>/dev/null)" != true ] || return 1
  # push.recurseSubmodules, when set, wins over submodule.recurse.
  g_sub="$(git -C "$f_cwd" config push.recurseSubmodules 2>/dev/null)" ||
    g_sub="$(git -C "$f_cwd" config --bool submodule.recurse 2>/dev/null)"
  case "$g_sub" in '' | no | false | check) ;; *) return 1 ;; esac
  # A push URL, or any URL rewrite, sends the push to another repository.
  [ -z "$(git -C "$f_cwd" config --get-all remote.origin.pushurl 2>/dev/null)" ] || return 1
  [ -z "$(git -C "$f_cwd" config --get-regexp '^url\..*\.(push)?insteadof$' 2>/dev/null)" ] || return 1
  case "$g_ref" in
    HEAD | "$g_branch") return 0 ;;
    '')
      # Push settings decide where a push with no branch goes: a push.default
      # such as matching sends other branches too, and a push remote sends it
      # elsewhere. Only the plain settings, and a push target git resolves to
      # origin's branch, go through.
      case "$(git -C "$f_cwd" config push.default 2>/dev/null)" in
        '' | simple | current | upstream | tracking) ;;
        *) return 1 ;;
      esac
      if [ -z "$g_remote" ]; then
        for g_key in remote.pushDefault "branch.$g_branch.pushRemote"; do
          case "$(git -C "$f_cwd" config "$g_key" 2>/dev/null)" in '' | origin) ;; *) return 1 ;; esac
        done
      fi
      [ "$(git -C "$f_cwd" rev-parse --abbrev-ref --symbolic-full-name '@{push}' 2>/dev/null)" = "origin/$g_branch" ] ;;
    *) return 1 ;;
  esac
}

# Succeeds when a grant is recorded and HEAD in the session's directory is on
# its branch.
on_grant_branch() {
  [ -f "$state/grant" ] &&
    [ "$(git -C "$f_cwd" symbolic-ref -q --short HEAD 2>/dev/null)" = "$(sed -n 1p "$state/grant")" ]
}

# Succeeds when HEAD's tree in the session's directory is the one the review
# loop last read.
tree_reviewed() {
  g_tree="$(git -C "$f_cwd" rev-parse -q --verify 'HEAD^{tree}' 2>/dev/null)"
  [ -n "$g_tree" ] && [ "$g_tree" = "$(cat "$state/reviewed-tree" 2>/dev/null)" ]
}

# Succeeds when the shell command in $command is a plain gh pr create: one
# command, perhaps over lines joined by a backslash, not a chain, that
# mentions no other head or repository anywhere, quoted or not: --head,
# --repo, -H or -R alone or in a cluster such as -dR, GH_REPO or GH_HOST. Its
# title may come from $(cat ...), as eng:pr writes it.
plain_pr() {
  # An escaped backslash, or a comment, leaves a line break a separator.
  case "$command" in *'\\
'*) return 1 ;; esac
  case "$command" in *'#'*"\\"*) return 1 ;; esac
  g_cmd="$(printf '%s\n' "$command" | sed -e ':a' -e '/\\$/N' -e 's/\\\n/ /' -e 'ta')"
  case "$g_cmd" in *';'* | *'&'* | *'|'* | *'
'*) return 1 ;; esac
  printf '%s' "$g_cmd" | grep -Eq '^[[:space:]]*gh[[:space:]]+pr[[:space:]]+create([[:space:]]|$)' || return 1
  ! printf '%s' "$g_cmd" |
    grep -Eq -- "--head|--repo|GH_REPO|GH_HOST|(^|[[:space:]\"'=])-[A-Za-z]*[HR]"
}

# Under a plan's grant, adds to $deny or $ask for a push or a pull request
# write the gate allowed. Through Bash, a push or a new pull request runs only
# on the granted branch and only when HEAD's tree is the one the review loop
# last read, and a push only as a plain one, six times. Through any other
# tool it asks.
grant_checks() {
  find_state && [ -f "$state/grant" ] || return 0
  g_branch="$(sed -n 1p "$state/grant")"
  g_name="$(sed -n 2p "$state/grant")"
  # Only a Bash command runs where the hook reads the branch and the tree, and
  # only its pushes are counted, so any other tool's push or pull request
  # write asks. A shell tool's push on the plan's branch of a tree no review
  # read is still denied.
  if [ "$tool" != Bash ]; then
    printf '%s\n' "$found" | grep -Eqx 'gate push|gate pr|open pr' || return 0
    case "$tool" in
      mcp__terminal__run_in_terminal | Monitor | PowerShell)
        if printf '%s\n' "$found" | grep -Eqx 'gate push|open pr' && on_grant_branch && ! tree_reviewed; then
          deny="Under the approved plan $g_name, only a tree the review loop read is pushed, and HEAD's tree is not the last one it read. Only a review at high or above, over a range that changes something, counts. Run the review step in eng:implement on this tree first."
          return 0
        fi ;;
    esac
    ask="${ask:+$ask }Under the approved plan $g_name, a push or a pull request write runs without asking only through the Bash tool. Confirm this one."
    return 0
  fi
  printf '%s\n' "$found" | grep -Eqx 'gate push|open pr' || return 0
  if ! on_grant_branch; then
    ask="${ask:+$ask }This is outside the approved plan $g_name, whose grant covers the branch $g_branch only. Confirm it."
    return 0
  fi
  if ! tree_reviewed; then
    deny="Under the approved plan $g_name, only a tree the review loop read is pushed, and HEAD's tree is not the last one it read. Only a review at high or above, over a range that changes something, counts. Run the review step in eng:implement on this tree first, and commit the reviewed changes as their own command before pushing. The review reads untracked files too, so one left out of the commit keeps the trees apart until it is deleted or ignored."
    return 0
  fi
  if printf '%s\n' "$found" | grep -qx 'open pr' && ! plain_pr; then
    ask="${ask:+$ask }Under the approved plan $g_name, only a plain gh pr create for $g_branch, in this repository, runs without asking, as its own command. Confirm this one."
    return 0
  fi
  printf '%s\n' "$found" | grep -qx 'gate push' || return 0
  if ! plain_push "$g_branch"; then
    ask="${ask:+$ask }Under the approved plan $g_name, only a plain git push of $g_branch runs without asking, as its own command. Confirm this one."
  elif [ "$(cat "$state/grant-pushes" 2>/dev/null || echo 0)" -ge 6 ]; then
    ask="${ask:+$ask }There have been six pushes under the approved plan $g_name already. Confirm this one."
  fi
}

# Prints what an MCP tool writes, in the parser's form, from its name split
# into words.
mcp_tool() {
  rest="${1#mcp__}"
  server="${rest%%__*}"
  name="${rest#*__}"
  # The Claude app's own servers carry its chat, panes and settings. The
  # terminal tool that runs a command is read as a shell command instead.
  case "$1" in
    mcp__ccd_pr__set_auto_merge) printf 'confirm %s\n' "$1"; return 0 ;;
  esac
  case "$server" in
    hearthbot | claude-code-remote | ccd_* | visualize | Claude_Browser | claude-in-chrome | \
      terminal | scheduled-tasks | Claude_Code_iOS_Simulator | ide) return 0 ;;
  esac
  # createPRReview splits into create, PR and Review.
  words=" $(printf '%s' "$name" | sed 's/\([a-z0-9]\)\([A-Z]\)/\1 \2/g; s/\([A-Z]\)\([A-Z][a-z]\)/\1 \2/g' |
    tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' ' ') "
  # Making a draft is not a write, since you send it yourself. Sending,
  # deleting, publishing or scheduling one is.
  case "$words" in
    *" pull request "* | *" merge request "*) ;;
    # Publishing a draft note on GitLab posts it.
    *" publish draft note "* | *" publish draft notes "*) printf 'post %s\n' "$1"; return 0 ;;
    *" draft "* | *" drafts "*)
      # Slack's send_message_draft only makes a message draft.
      case "$words" in *" message draft "*) return 0 ;; esac
      for v in send delete publish schedule; do
        case "$words" in *" $v "*) printf 'confirm %s\n' "$1"; return 0 ;; esac
      done
      return 0 ;;
  esac
  # The first word that reads or writes decides, so get_commit and
  # comments_list read and delete_list writes. A read joined to a write, as in
  # get_or_create, writes.
  first=""
  for w in $(printf '%s' "$words" | sed 's/ pull request / pull_request /g; s/ merge request / merge_request /g'); do
    case " $READS $WRITES " in *" $w "*) first="$w"; break ;; esac
  done
  case " $READS " in
    *" $first "*)
      for v in $WRITES $POSTS; do
        case "$words" in *" or $v "* | *" and $v "*) first="$v" ;; esac
      done ;;
  esac
  # An HTTP-shaped name such as API-post-search reads when it searches.
  case "$first" in
    post) case "$words" in *" search "* | *" query "*) return 0 ;; esac ;;
  esac
  case " $READS " in *" $first "*) return 0 ;; esac
  # Sending or posting a message, a DM or a chat line is a post. In a chat
  # service, adding or writing one is too, and Slack's and Teams' own tool
  # names say so even under a connector named by an id.
  case "$words" in
    *" conversations add message "* | *" create chat message "* | *" create channel message "*)
      printf 'post %s\n' "$1"; return 0 ;;
  esac
  case "$words" in
    *" send "* | *" post "* | *" schedule "*)
      case "$words" in
        *" message "* | *" messages "* | *" dm "* | *" chat "*) printf 'post %s\n' "$1"; return 0 ;;
      esac ;;
  esac
  case "$server" in
    *[Ss]lack* | *[Tt]eams* | *[Dd]iscord* | *[Cc]hat* | *[Zz]ulip* | *[Mm]attermost* | \
      *[Ww]hats[Aa]pp* | *[Tt]elegram* | *[Ii]ntercom* | *[Ww]ebex*)
      case "$words" in
        *" add message "* | *" add messages "* | *" create message "* | *" create messages "* | *" write message "* | *" chat write "* | *" create post "* | *" create posts "*)
          printf 'post %s\n' "$1"; return 0 ;;
      esac ;;
  esac
  # A note or discussion on a merge request or an issue is a comment, and so
  # is resolving a review thread.
  case "$words" in
    *" note "* | *" notes "* | *" discussion "* | *" thread "*)
      case "$words" in
        *" merge request "* | *" issue "* | *" mr "*) printf 'post %s\n' "$1"; return 0 ;;
      esac
      # GitLab calls a comment a note, but release notes are not comments.
      case "$server:$words" in
        *[Gg]it[Ll]ab*:*" release "*) ;;
        *[Gg]it[Ll]ab*:*) printf 'post %s\n' "$1"; return 0 ;;
      esac ;;
  esac
  case "$words" in
    *" resolve "*)
      case "$words" in *" thread "* | *" discussion "* | *" comment "*) printf 'post %s\n' "$1"; return 0 ;; esac ;;
  esac
  # A git server's commit and push are the same writes as the git commands.
  case "$words" in
    *" git commit "* | *" commit changes "*) printf 'gate commit\n'; return 0 ;;
    *" git push "*) printf 'gate push\n'; return 0 ;;
  esac
  # Asking for a review is not posting one. "pull request" and "merge request"
  # are nouns, not that.
  case "$(printf '%s' "$words" | sed 's/ pull request / pull_request /g; s/ merge request / merge_request /g')" in
    *" request "*) ;;
    *)
      for w in $POSTS; do
        case "$words" in *" $w "*) printf 'post %s\n' "$1"; return 0 ;; esac
      done
      # A reaction, but not React the library.
      case "$words" in
        " react " | *" react to "* | *" emoji react "* | *" react message "* | *" message react "* | *" react comment "*)
          printf 'post %s\n' "$1"; return 0 ;;
      esac ;;
  esac
  # A claude.ai connector's server is named by an id, so GitHub's own words
  # in the tool's name count too.
  github=no
  case "$server" in *[Gg]it[Hh]ub*) github=yes ;; esac
  case "$words" in *" pull request "* | *" push files "* | *" or update file "*) github=yes ;; esac
  case "$github" in
    yes)
      # Pushing files, or writing one, commits straight to the remote.
      case "$words" in
        *" push "* | *" file "* | *" files "*) printf 'gate push\n'; return 0 ;;
        *" create branch "* | *" create ref "* | *" update ref "*) printf 'gate push\n'; return 0 ;;
      esac
      for v in create update add remove edit close reopen delete set assign write convert reprioritize; do
        case "$words" in *" $v "*) ;; *) continue ;; esac
        case "$words" in
          *" issue "* | *" issues "* | *" label "* | *" labels "* | *" milestone "* | *" sub "*)
            printf 'gate issue\n'; return 0 ;;
          *" pull request "* | *" pr "*)
            # Updating a branch merges the base into it, as gh pr
            # update-branch does, which asks.
            case "$words" in *" branch "*) printf 'gate pr\nconfirm %s\n' "$1"; return 0 ;; esac
            case "$v" in create | update | edit | convert) printf 'gate pr\n'; return 0 ;; esac ;;
        esac
      done ;;
  esac
  for v in $RISKY; do
    case "$words" in *" $v "*) printf 'confirm %s\n' "$1"; return 0 ;; esac
  done
  # A noun asks beside any verb not known as a read, so finalize_invoice
  # asks while describe_deployments, a read, returned above.
  for n in $NOUNS; do
    case "$words" in *" $n "*) printf 'confirm %s\n' "$1"; return 0 ;; esac
  done
  # Any other tool, an edit or one whose name says nothing, asks only when its
  # input does something risky. A tool whose name updates moves what it
  # changes when it names a new parent, while one that creates or copies puts
  # the new file there.
  case "$words" in *" update "* | *" patch "* | *" modify "* | *" set "* | *" edit "*) moving=true ;; *) moving=false ;; esac
  risky_input "$moving" && printf 'confirm %s\n' "$1"
  return 0
}

# Succeeds when the tool input asks for something risky, whatever the tool is
# called. jq reads the input as a tree, with a payload sent as a JSON string
# decoded first, and looks for:
# - a verb, action, command, operation or method that is one of the risky
#   words or has one among the words that name its command, such as a Claude Docs batch member
#   that deletes a tab or a whole doc, PostHog's "feature-flag delete 12", or
#   an HTTP method of DELETE, though not POST, which mostly creates;
# - a status, state, folder, mailbox, destination, location, target or move
#   key set to trash, trashed or deleted, and a label of trash, as Gmail and
#   WordPress trash things;
# - a key that deletes, trashes, archives or drops, set to true or to an
#   object, such as Notion's in_trash or allow_deleting_content, Drive's
#   trashed, or a Sheets deleteSheet request;
# - a key about access or visibility, such as a permission, a protected range,
#   sharing or public;
# - a key about people: an assignee, reviewer, invitee, attendee, recipient,
#   subscriber, delegate, member or new owner, set to anyone but me, with a
#   number counting only under a key ending in id, or an owner or person set
#   to a list or object naming anyone but me, or to an email address, which
#   covers a Notion page assigned to someone through its people property. A
#   bare owner, a repo owner or an owner type is not a person, so a plain
#   name there passes;
# - a key that sends a notification, such as a calendar's sendUpdates or a
#   notify flag;
# - a person named in content: a user:// link, or a mention of a user other
#   than you;
# - a comment made through a generic tool, such as a Claude Docs utterance;
# - in a sql, query, queries, statement, statements or ddl key, a string or
#   list holding a SQL drop of a table, column, database, schema, index, view,
#   function, constraint or trigger, a truncate, or a delete from, such as
#   Notion's DROP COLUMN. Other keys are not read for SQL, so prose passes;
# - with $1 true, a new parent or folder, which moves the file.
# Deleting text inside a doc through an op such as Claude Docs' delete is
# editing it, so a key named op is not read, though one named operation is. A jq failure is logged and
# counts as nothing risky, as every check but the command parser fails open.
risky_input() {
  [ -n "$input" ] || return 1
  # shellcheck disable=SC2016
  printf '%s' "$input" | jq -e --argjson moving "$1" --arg risky "$RISKY" '
    ($risky | split(" ") | map(select(. != ""))) as $words
    | def lower: ascii_downcase;
      def filled: . == true or ((type == "object" or type == "array") and length > 0);
      def personal: filled or (type == "string" and test("@|user://"));
      def set_: filled or (type == "string" and length > 0) or (type == "number");
      def me: type == "string" and (lower | gsub("^\\s+|\\s+$"; "")) == "me";
      def someone: (type == "string" and length > 0 and (me | not)) or (type == "number" and . != 0)
        or ((type == "object" or type == "array") and length > 0);
      def others($id):
        if type == "array" then any(.[]; someone)
        elif type == "object" then length > 0
        elif type == "number" then . != 0 and $id
        elif type == "string" then length > 0 and (me | not)
        else . == true end;
      def decode: walk(if type == "string" then (fromjson? // .) else . end);
      def risky:
        if type == "string" then
          test("user://")
        elif type == "object" then
          ((.type | type) == "string" and (.type | lower) == "mention"
            and ((has("user") and (.user | tostring | lower) != "me")
              or (.mention | type) == "object" and (.mention.type // "" | tostring | lower) == "user"))
          or any(to_entries[]; .key as $key | ($key | lower) as $k | .value as $v
            | (($k | IN("verb", "action", "command", "operation", "method"))
                and ($v | type) == "string"
                and ($v | lower | [splits("\\s+") | select(. != "")]
                  # In a value of several words, such as "feature-flag delete
                  # 12" or "gh repo delete x", up to three words name the
                  # command and its verb. run, execute and invoke among them
                  # do not count, since a command line such as "npm run test"
                  # names them to read. An option before the verb is passed
                  # over with its value, as in "kubectl -n prod delete pod x",
                  # and one after it starts the arguments, as in
                  # "feature-flag list --search delete".
                  | (if length > 1 then
                      ((map(startswith("-")) | index(false)) // length) as $start
                      | .[$start:]
                      | reduce (.[1:][]) as $w ({out: .[0:1], skip: false, done: false};
                          if .done then .
                          elif .skip then .skip = false
                          elif ($w | startswith("-")) then
                            if (.out | length) > 1 then .done = true
                            else .skip = ($w | contains("=") | not) end
                          else .out += [$w] | .done = ((.out | length) >= 3) end)
                      | .out
                      | map(select(IN("run", "execute", "invoke") | not))
                    else . end)
                  | any(.[]; IN($words[]) and (. != "post" or $k != "method"))))
              or (($k | IN("sql", "query", "queries", "statement", "statements", "ddl"))
                and ($v | if type == "array" then map(tostring) | join(";") else tostring end
                  | test("\\b(drop\\s+(table|column|database|schema|index|view|function|constraint|trigger)|truncate(\\s+table)?\\s+\\w+|delete\\s+from)\\b"; "i")))
              or (($k | test("status|state|folder|mailbox|destination|location|target|move")) and $k != "statement"
                and ($v | type) == "string"
                and ($v | lower | gsub("^\\s+|\\s+$"; "") | IN("trash", "trashed", "deleted")))
              or (($k | test("label")) and ($v | tostring | test("\\btrash\\b"; "i")))
              or (($k | gsub("[_-]"; "") | test("^(send(updates|notifications?|notificationemails?|emails?|invites?|invitations?)|notify(users|recipients|people|attendees|followers)?)$"))
                and ($v | set_) and ($v | tostring | lower | IN("none", "false", "0") | not))
              or (($k | IN("object", "type")) and ($v | type) == "string"
                and ($v | lower | IN("utterance", "comment", "reply")))
              or ((($key | test("^((delete|remove|purge|destroy|drop|Delete|Remove|Purge|Destroy|Drop)([A-Z_-]|$)|(DELETE|REMOVE|PURGE|DESTROY|DROP)([_-]|$))"))
                  or ($k | test("trash|archiv|delet")))
                and ($v | filled))
              or (($k | test("permission|protect|canshare|^(share|sharing|shared|access|accesslevel|role|roles|visibility|public|published|private|is_public)$"))
                and ($v | set_ or . == false))
              or (($k | test("assign|reviewer|collaborat|invite|attendee|recipient|subscriber|delegate"))
                and ($v | others($k | test("ids?$"))))
              or (($k | gsub("[_-]"; "") | IN("member", "members", "memberid", "memberids", "ownerid", "ownerids"))
                and ($v | others(true)))
              or (($k | test("owner") and ($k | test("^owner$|repo|type") | not)) and ($v | others(false)))
              or (($k | IN("owner", "people", "person", "persons"))
                and ($v | if type == "array" then any(.[]; someone) else personal end))
              or ($moving and ($k | gsub("[_-]"; "") | IN("parentid", "parent", "addparents", "removeparents",
                "newparent", "newparentid", "folderid", "destinationfolderid", "destinationfolder",
                "destinationparentid", "targetfolderid", "targetparentid"))))
        else false end;
      any(.tool_input // {} | decode | decode | ..; risky)
  ' > /dev/null 2>&1
  case $? in
    0) return 0 ;;
    1) return 1 ;;
    *) log "the MCP input check failed"; return 1 ;;
  esac
}

# The guard on a code-review the model calls, under whatever namespace.
skill_call() {
  name="$(skill_name "$(get .tool_input.skill)")"
  case "${name##*:}" in code-review | review) ;; *) return 0 ;; esac
  args="$(get .tool_input.args)"
  if has_word "$args" "$POST_FLAGS"; then
    decision deny "$POST_REASON"
  elif has_word "$args" 'ultra|--fix(=[^[:space:]]*)?'; then
    decision deny "Run code-review at an explicit level such as high, without ultra or --fix, and apply its findings yourself."
  fi
}

# Runs the command parser on $1 and prints what it found. A parser still
# running after the time limit is stopped and the function returns 143, the
# status of a process stopped by TERM. What it printed before it stopped is
# kept, though a parser stopped while it was still splitting the command has
# printed nothing. The timer is stopped as soon as the parser ends, and its
# output goes nowhere, so the $( ) around this call does not wait for it.
parse_command() {
  limit="$PARSE_SECONDS"
  case "${ENG_HOOK_PARSE_SECONDS:-}" in
    '' | *[!0-9]*) ;;
    *) [ "$ENG_HOOK_PARSE_SECONDS" -gt 0 ] && [ "$ENG_HOOK_PARSE_SECONDS" -lt "$limit" ] && limit="$ENG_HOOK_PARSE_SECONDS" ;;
  esac
  printf '%s' "$1" | awk -f "$root/hooks/classify-command.awk" &
  parser=$!
  (
    trap 'kill "$nap" 2>/dev/null; exit 0' TERM
    sleep "$limit" &
    nap=$!
    wait "$nap" && kill "$parser"
  ) > /dev/null 2>&1 &
  timer=$!
  wait "$parser" 2>/dev/null
  parsed=$?
  kill "$timer" 2>/dev/null
  return "$parsed"
}

on_pre_tool() {
  tool="$f_tool"
  failed=""
  case "$tool" in
    Bash | Monitor | PowerShell | mcp__terminal__run_in_terminal)
      command="$(get .tool_input.command)"
      [ -n "$command" ] || return 0
      # Unlike the other checks, a classifier that fails asks rather than
      # allows, because a command it could not read may post or write. What
      # it printed before it stopped still counts, so a post it found, or a
      # write the gate refuses, is still denied.
      found="$(parse_command "$command")" || {
        status=$?
        if [ "$status" -eq 143 ]; then
          failed="The hook's command parser could not read this command within its time limit, so it cannot tell whether it posts or writes outside this machine. Check it before it runs."
        else
          log "the command parser failed with exit status $status"
          failed="The hook's command parser failed, so it cannot tell whether this command posts or writes outside this machine. Check it before it runs."
        fi
      } ;;
    Skill) skill_call; return 0 ;;
    mcp__*) found="$(mcp_tool "$tool")" ;;
    *) return 0 ;;
  esac
  [ -n "$found" ] || [ -n "$failed" ] || return 0

  # Tiers apply in order: a post is denied outright, and a push the write gate
  # allows still asks when it forces, deletes or pushes tags.
  deny="" ask=""
  while IFS= read -r line; do
    kind="${line%% *}"
    what="${line#* }"
    case "$kind" in
      post) [ -n "$deny" ] || deny="$POST_REASON" ;;
      gate)
        gate "$what"
        [ "$verdict" = deny ] && [ -z "$deny" ] && deny="$reason" ;;
      confirm) ask="${ask:+$ask }This can write outside this machine: $what. Confirm it." ;;
    esac
  done <<EOF
$found
EOF
  [ -z "$failed" ] || ask="${ask:+$ask }$failed"
  # A subagent's push is already denied.
  [ -z "$deny" ] && [ -z "$f_agent" ] && grant_checks
  # A command the gate denies never runs, so it has nothing to compare.
  [ -z "$deny" ] && [ "$tool" = Bash ] && note_push
  if [ -n "$deny" ]; then
    decision deny "$deny"
  elif [ -n "$ask" ]; then
    decision ask "$ask"
  fi
}

# Prints the remote branches that point at HEAD in the repo at $1, one per
# line, leaving out each remote's default branch, which no pull request is
# opened from. Where a remote names no default, main and master stand in.
pushed_refs() {
  defaults="$(default_refs "$1")"
  git -C "$1" for-each-ref --points-at HEAD --format='%(refname)' refs/remotes/ 2>/dev/null |
    while IFS= read -r ref; do
      case "$ref" in refs/remotes/*/HEAD) continue ;; esac
      printf '%s\n' "$defaults" | grep -qxF "$ref" && continue
      printf '%s\n' "$ref"
    done
}

# Prints the name of the file that keeps a push or pull request command's
# state between its two hooks: its tool call's id, or the command's hash where
# Claude Code sends no id. Two commands running at once each keep their own.
# One the user declines at a prompt leaves its file until the turn ends.
pending_file() {
  key="$(get .tool_use_id | tr -c 'A-Za-z0-9_\n-' '-')"
  [ -n "$key" ] || key="$(printf '%s' "$(get .tool_input.command)" | git hash-object --stdin 2>/dev/null)"
  printf '%s\n' "push-pending.$key"
}

# Before a push or a pull request command, which the classifier named in
# $found, keeps its kind, its repo and where every remote branch stood,
# so the post-tool hook can tell what it moved, even when the same command
# also commits. Opening a pull request, which the classifier names with
# "open pr", needs its branch pushed, not moved.
note_push() {
  [ -z "$f_agent" ] || return 0
  # Editing a pull request pushes nothing and opens nothing.
  printf '%s\n' "$found" | grep -Eqx 'gate push|open pr' || return 0
  kind=push
  printf '%s\n' "$found" | grep -qx 'open pr' && kind=open
  find_state || return 0
  # Outside a repo there is nothing to compare against afterwards.
  top="$(git -C "$f_cwd" rev-parse --show-toplevel 2>/dev/null)" || return 0
  {
    printf '%s\n' "$kind"
    printf '%s\n' "$top"
    git -C "$f_cwd" for-each-ref --format='%(objectname) %(refname)' refs/remotes/ 2>/dev/null
  } > "$state/$(pending_file)"
}

# After the command note_push kept, records HEAD as the commit to review as a
# pull request: a push that moved a remote branch to it, or a pull request
# opened on a branch already there. A push that moved only tags, a deletion
# or the default branch moves no such branch, and records nothing. The refs
# decide a push, not the exit status, because a command can fail after its
# push landed. A pull request that failed to open counts only when its
# command's push moved a branch.
record_push() {
  # Most commands push nothing, so look for any such file before working out
  # which one this command would have.
  dir="$(state_path)" || return 0
  set -- "$dir"/push-pending.*
  [ -e "$1" ] || return 0
  file="$(pending_file)"
  [ -f "$dir/$file" ] || return 0
  find_state || return 0
  pending="$(cat "$state/$file" 2>/dev/null)"
  rm -f "$state/$file"
  kind="$(printf '%s\n' "$pending" | sed -n 1p)"
  # A command that changed directory is judged in the repo it started in.
  [ "$(printf '%s\n' "$pending" | sed -n 2p)" = "$(git -C "$f_cwd" rev-parse --show-toplevel 2>/dev/null)" ] || return 0
  head="$(git -C "$f_cwd" rev-parse -q --verify HEAD 2>/dev/null)" || return 0
  after="$(pushed_refs "$f_cwd")"
  [ -n "$after" ] || return 0
  if [ "$kind" != open ] || [ "$f_event" = PostToolUseFailure ]; then
    before="$(printf '%s\n' "$pending" | sed '1,2d')"
    moved=no
    for ref in $after; do
      printf '%s\n' "$before" | grep -qxF "$head $ref" || moved=yes
    done
    [ "$moved" = yes ] || return 0
  fi
  printf '%s\n' "$head" > "$state/pr-head"
  if on_grant_branch; then
    [ "$kind" = push ] &&
      printf '%s\n' "$(($(cat "$state/grant-pushes" 2>/dev/null || echo 0) + 1))" > "$state/grant-pushes"
    log_write "$kind" "$head"
  fi
  # A pull request opened on a commit whose push was already reminded about
  # asks for its own review.
  [ "$kind" = open ] && rm -f "$state/pr-reminded"
  # A review of the whole range ending here, run before the push, covers it.
  mark_pr_reviewed "$(cat "$state/reviewed-commit" 2>/dev/null)"
}

on_post_tool() {
  case "$f_tool" in
    # A skill a subagent loads leaves the main session's gate as it was.
    Skill)
      [ -n "$f_agent" ] && return 0
      name="$(skill_name "$(get .tool_input.skill)")"
      # A review that ran, as opposed to one that was asked for and refused.
      case "${name##*:}" in code-review | review) record_review "$(get .tool_input.args)" ;; esac
      record_skill "$name" ;;
    Bash)
      # A merge that stops on a conflict exits 1, which fires
      # PostToolUseFailure with the output in error rather than PostToolUse.
      event="$f_event"
      # A subagent never pushes.
      [ -z "$f_agent" ] && record_push
      if printf '%s' "$input" | jq -r '(.error // empty), (.tool_response // empty
          | if type == "object" then [.stdout, .stderr] | map(. // "") | join("\n") else tostring end)' 2>/dev/null |
        grep -Eq 'CONFLICT \(|Automatic merge failed|Merge conflict in|could not apply'; then
        context "${event:-PostToolUse}" "Git reported a conflict. When the user's latest message asks for this operation, the eng:merge-conflicts skill resolves it."
      fi ;;
  esac
}

on_stop() {
  # Every tool call of the turn has finished, so a push command's state still
  # here belongs to one that never ran, such as one the user declined.
  if dir="$(state_path)"; then rm -f "$dir"/push-pending.*; fi
  # Once per turn: a stop this hook already continued passes.
  [ "$(get .stop_hook_active)" = true ] && return 0
  # A code-review still running in the background reports back later.
  if printf '%s' "$input" | jq -e '[.background_tasks[]?
      | select((.status // "running") | test("^(running|pending)$"))
      | ((.description // "") + " " + (.agent_type // ""))
      | select(test("code.?review"; "i"))] | length > 0' >/dev/null 2>&1; then
    return 0
  fi
  find_state || return 0
  now="$(tree_state "$f_cwd")" || return 0
  if [ "$now" != clean ] && [ "$now" != "$(cat "$state/start-hash" 2>/dev/null)" ] &&
    [ "$now" != "$(cat "$state/review-hash" 2>/dev/null)" ]; then
    context Stop "$REVIEW_REMINDER"
    return 0
  fi
  # The pushed commit, once, while HEAD is still on it and no review reached it.
  pushed="$(cat "$state/pr-head" 2>/dev/null)" || return 0
  [ -n "$pushed" ] || return 0
  [ "$pushed" = "$(cat "$state/pr-review" 2>/dev/null)" ] && return 0
  [ "$pushed" = "$(cat "$state/pr-reminded" 2>/dev/null)" ] && return 0
  [ "$pushed" = "$(git -C "$f_cwd" rev-parse -q --verify HEAD 2>/dev/null)" ] || return 0
  printf '%s\n' "$pushed" > "$state/pr-reminded"
  # Under a plan's grant, on its branch, the run reviews the whole pull
  # request before it hands back, rather than only being told to.
  if on_grant_branch; then
    jq -n --arg r "$PR_REMINDER" '{decision: "block", reason: $r}'
  else
    context Stop "$PR_REMINDER"
  fi
}

input="$(cat)"
# The fields most modes read, parsed once.
f_sid="" f_cwd="" f_agent="" f_tool="" f_event=""
if command -v jq >/dev/null 2>&1; then
  # tostring keeps every value one quoted word, whatever its JSON type.
  eval "$(printf '%s' "$input" | jq -r '@sh "f_sid=\(.session_id // "" | tostring) f_cwd=\(.cwd // "" | tostring) f_agent=\(.agent_id // "" | tostring) f_tool=\(.tool_name // "" | tostring) f_event=\(.hook_event_name // "" | tostring)"' 2>/dev/null)"
fi
case "$mode" in
  session-start) session_start ;;
  prompt | expansion | pre-tool | post-tool | stop)
    if ! command -v jq >/dev/null 2>&1; then
      log "jq not found, so the $mode hook did nothing"
      exit 0
    fi
    case "$mode" in
      prompt) on_prompt ;;
      expansion) on_expansion ;;
      pre-tool) on_pre_tool ;;
      post-tool) on_post_tool ;;
      stop) on_stop ;;
    esac ;;
  *) log "unknown mode '$mode'" ;;
esac
exit 0
