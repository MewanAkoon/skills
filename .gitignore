node_modules/
.DS_Store

# A global ignore of .claude/ (see the README setup) would hide this repo's
# own rules. Un-ignore that one directory and nothing else, so worktree
# checkouts and local settings stay out.
!.claude/
.claude/*
!.claude/rules/

# A local choice of which skills to link, per machine. Commit it in a fork if
# the whole fork wants the same subset.
.skillsignore
